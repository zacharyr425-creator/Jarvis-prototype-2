                        <a href="https://theathletic.com" target="_blank" class="site-link" data-name="the athletic" data-search="https://theathletic.com/search/?q="><span>The Athletic</span> ↗</a>
                    </div>

                    <div class="site-category">2. SCIENCE</div>
                    <div class="site-links-grid">
                        <a href="https://www.sciencenews.org" target="_blank" class="site-link" data-name="sciencenews" data-search="https://www.sciencenews.org/?s="><span>ScienceNews</span> ↗</a>
                        <a href="https://www.nasa.gov" target="_blank" class="site-link" data-name="
