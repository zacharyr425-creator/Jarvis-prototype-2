        /* LIVE NEWS & SEARCH FETCH ENGINE */
        async function fetchLiveNewsAndData(query) {
            showPanel('right');
            const rightContent = document.getElementById('right-content');
            rightContent.innerHTML = '<p style="color:#00f0ff;">Searching global networks for: ' + query + '...</p>';
            
            try {
                const newsRssUrl = `https://news.google.com/rss/search?q=${encodeURIComponent(query)}&hl=en-US&gl=US&ceid=US:en`;
                const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(newsRssUrl)}`;
                
                const response = await fetch(apiUrl);
                const data = await response.json();

                if (data.status === 'ok' && data.items && data.items.length > 0) {
                    rightContent.innerHTML = '';
                    const items = data.items.slice(0, 5);

                    items.forEach((item) => {
                        const card = document.createElement('div');
                        card.className = 'response-card';
                        
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = item.description || item.content;
                        const cleanText = tempDiv.innerText.slice(0, 220) + '...';

                        card.innerHTML = `
                            <div class="card-source">${item.author || data.feed.title || 'LIVE DATA FEED'}</div>
                            <div class="card-title">${item.title}</div>
                            <div class="card-snippet">${cleanText}</div>
                            <div class="card-actions">
                                <button class="expand-btn" onclick="this.closest('.response-card').classList.toggle('enlarged')">ENLARGE</button>
                                <a href="${item.link}" target="_blank" class="link-btn">READ MORE ↗</a>
                            </div>
                        `;
                        rightContent.appendChild(card);
                    });

                    const topSummary = items[0].title;
                    speak(`Found current updates on ${query}, Sir. Top item: ${topSummary}`);
                    return;
                }
            } catch (err) {}

            try {
                const wikiUrl = `https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(query)}`;
                const wikiRes = await fetch(wikiUrl);
                
                if (wikiRes.ok) {
                    const wikiData = await wikiRes.json();
                    if (wikiData.extract) {
                        rightContent.innerHTML = `
                            <div class="response-card enlarged">
                                <div class="card-source">WIKIPEDIA DATABASE</div>
                                <div class="card-title">${wikiData.title}</div>
                                <div class="card-snippet">${wikiData.extract}</div>
                                <div class="card-actions">
                                    <a href="${wikiData.content_urls.desktop.page}" target="_blank" class="link-btn">FULL ARTICLE ↗</a>
                                </div>
                            </div>
                        `;
                        speak(wikiData.extract.slice(0, 180) + "...");
                        return;
                    }
                }
            } catch (e) {}

            rightContent.innerHTML = `
                <div class="response-card">
                    <div class="card-source">GLOBAL SEARCH</div>
                    <div class="card-title">Query: ${query}</div>
                    <div class="card-snippet">Unable to pull live feed preview directly. You can launch full web results below:</div>
                    <div class="card-actions">
                        <a href="https://www.google.com/search?q=${encodeURIComponent(query)}" target="_blank" class="link-btn">SEARCH GOOGLE ↗</a>
                    </div>
                </div>
            `;
            speak(`I generated live search queries for ${query}, Sir.`);
        }

        async function processInput() {  
            const inputField = document.getElementById('userInput');
            if (!inputField) return;  
            const query = inputField.value.trim();  
            if (!query) return;  

            inputField.value = '';  
            const qLower = query.toLowerCase().replace(/['’]/g, '');

            // ------------------------------------------
            // 1. STOP AUDIO / QUIET COMMAND
            // ------------------------------------------
            if (qLower === 'stop' || qLower === 'jarvis stop' || qLower === 'quiet' || qLower === 'shut up' || qLower.includes('stop talking') || qLower.includes('stop reading')) {
                stopSpeaking();
                return;
            }

            // ------------------------------------------
            // 2. NOTES SYSTEM (TAKE NOTES FOR LATER)
            // ------------------------------------------
            if (qLower.includes('take a note') || qLower.includes('jot down') || qLower.includes('write down') || (qLower.includes('note') && qLower.includes('for later'))) {
                let noteText = query.replace(/take a note/i, '').replace(/jot down/i, '').replace(/write down/i, '').replace(/for later/i, '').replace(/jarvis/i, '').replace(/note/i, '').trim();
                if (!noteText) noteText = "Important task logged for later.";

                const dateStr = new Date().toLocaleDateString();
                userNotes.push({ text: noteText, date: dateStr });
                renderNotes();
                showPanel('left');
                const noteElem = document.getElementById('notes-list');
                if (noteElem) noteElem.scrollIntoView({ behavior: 'smooth' });

                speak(`I've jotted that down in your notes, Sir: ${noteText}`);
                return;
            }

            if (qLower.includes('read my notes') || qLower.includes('show my notes') || qLower.includes('what are my notes')) {
                showPanel('left');
                const noteElem = document.getElementById('notes-list');
                if (noteElem) noteElem.scrollIntoView({ behavior: 'smooth' });

                if (userNotes.length === 0) {
                    speak("You have no saved notes for later, Sir.");
                } else {
                    let summary = userNotes.map(n => n.text).join('. ');
                    speak(`Here are your saved notes, Sir: ${summary}`);
                }
                return;
            }

            // ------------------------------------------
            // 3. BUILD & ENGINEERING ASSISTANT
            // ------------------------------------------
            if (qLower.includes('help me build') || qLower.includes('how to build') || qLower.includes('design') || qLower.includes('build blueprint')) {
                let itemToBuild = query.replace(/help me build/i, '').replace(/how to build/i, '').replace(/build/i, '').replace(/design/i, '').replace(/jarvis/i, '').trim();
                if (!itemToBuild) itemToBuild = "Custom Project Prototype";

                generateBuildSchematic(itemToBuild);
                return;
            }

            // ------------------------------------------
            // 4. CAPABILITIES INQUIRY
            // ------------------------------------------
            if (qLower.includes('capabilities') || qLower.includes('what can you do') || qLower.includes('what are your features') || qLower.includes('what are you capable of')) {
                listJarvisCapabilities();
                return;
            }

            // ------------------------------------------
            // 5. FAVORITE WEBSITES COMMANDS
            // ------------------------------------------
            if (qLower.includes('add') && (qLower.includes('favorite website') || qLower.includes('favorite site') || qLower.includes('favorites list'))) {
                let cleanName = query.replace(/add/i, '').replace(/to (my )?(favorite websites|favorite sites|favorites list|favorites)/i, '').replace(/website|site/i, '').trim();
                
                if (!cleanName) cleanName = "New Favorite";
                let targetUrl = cleanName.toLowerCase().startsWith('http') ? cleanName : `https://www.${cleanName.replace(/\s+/g, '')}.com`;

                favoriteWebsites.push({ name: cleanName, url: targetUrl });
                renderFavorites();
                showPanel('left');
                speak(`Added ${cleanName} to your saved favorite websites, Sir.`);
                return;
            }

            if (qLower.includes('favorite website') || qLower.includes('favorite site') || qLower.includes('show my favorites') || qLower.includes('open favorite')) {
                showPanel('left');
                const favMatch = favoriteWebsites.find(s => qLower.includes(s.name.toLowerCase()));
                if (favMatch) {
                    speak(`Opening your favorite website, ${favMatch.name}, Sir.`);
                    window.open(favMatch.url, '_blank');
                } else {
                    speak("Here are your saved favorite websites on your left HUD panel, Sir.");
                }
                return;
            }

            // ------------------------------------------
            // 6. WAKE WORDS INTEGRATION
            // ------------------------------------------
            if (qLower.includes('wake up daddys home') || qLower.includes('wake up daddy home')) {
                speak("Welcome back, Sir. All systems operational and standing by.");
                const arc = document.getElementById('arcReactor');
                if (arc) arc.style.transform = 'scale(1.2)';
                setTimeout(() => { if (arc) arc.style.transform = 'scale(1)'; }, 1500);
                return;
            }

            if (qLower === 'hey jarvis' || qLower === 'hi jarvis' || qLower === 'hello jarvis') {
                const randomGreeting = GREETING_RESPONSES[Math.floor(Math.random() * GREETING_RESPONSES.length)];
                speak(randomGreeting);
                return;
            }

            if (qLower.includes('good morning jarvis') || qLower.includes('what weve got on the calendar') || qLower.includes('what we got on the calendar') || qLower.includes('tell me what weve got on the calendar today')) {
                showPanel('left');
                const calElem = document.getElementById('calendar-list');
                if (calElem) calElem.scrollIntoView({ behavior: 'smooth' });

                if (familyCalendar.length === 0) {
                    speak("Good morning, Sir. Your calendar is completely clear for today.");
                } else {
                    let summary = familyCalendar.map(evt => `${evt.title} on ${evt.date}`).join(', ');
                    speak(`Good morning, Sir. Here is what is on your calendar today: ${summary}`);
                }
                return;
            }

            // ------------------------------------------
            // 7. CALENDAR INTENTS
            // ------------------------------------------
            if (qLower.includes('add') && (qLower.includes('calendar') || qLower.includes('calander') || qLower.includes('event') || qLower.includes('schedule'))) {
                let cleanTitle = query.replace(/add/i, '').replace(/to (my |the )?(google )?(calendar|calander)/i, '').replace(/schedule/i, '').trim();
                const today = new Date().toISOString().split('T')[0];
                const eventName = cleanTitle || "New Event";
                
                familyCalendar.push({ title: eventName, date: today });
                renderCalendar();
                showPanel('left');

                speak(`Added ${eventName} to your calendar list, Sir. Opening Google Calendar now.`);
                syncToGoogleCalendar(encodeURIComponent(eventName), today);
                return;
            }

            if (qLower.includes('calendar') || qLower.includes('calander')) {
                showPanel('left');
                const calElem = document.getElementById('calendar-list');
                if (calElem) calElem.scrollIntoView({ behavior: 'smooth' });
                
                speak("Opening Google Calendar for you, Sir.");
                window.open("https://calendar.google.com", "_blank");
                return;
            }

            // ------------------------------------------
            // 8. PERMANENT MEMORY COMMANDS
            // ------------------------------------------
            if (qLower.startsWith('remember ') || qLower.startsWith('save ')) {
                const parts = query.replace(/remember|save/i, '').trim().split(/ as | is /i);
                if (parts.length >= 2) {
                    const key = parts[0].trim().toLowerCase();
                    const value = parts[1].trim();
                    jarvisMemory[key] = value;
                    saveStateToDisk();
                    speak(`Saved to permanent memory. ${key} is set to ${value}.`);
                    return;
                }
            }

            if (qLower.startsWith('what is ') || qLower.startsWith('recall ')) {
                const key = qLower.replace(/what is|recall/i, '').replace(/[^a-z0-9\s]/gi, '').trim();
                if (jarvisMemory[key]) {
                    speak(`I remembered that ${key} is ${jarvisMemory[key]}.`);
                    return;
                }
            }

            // ------------------------------------------
            // 9. INTERFACE COMMANDS
            // ------------------------------------------
            if (qLower.includes('move this to the other side') || qLower.includes('move to the other side') || qLower.includes('swap sides') || qLower.includes('switch side')) {
                const workspace = document.getElementById('workspace');
                if (workspace.style.gridTemplateColumns === '380px 1fr 340px') {
                    workspace.style.gridTemplateColumns = '340px 1fr 380px';
                } else {
                    workspace.style.gridTemplateColumns = '380px 1fr 340px';
                }
                speak("Reconfiguring interface layout to the opposite side, Sir.");
                return;
            }

            if (qLower.includes('enlarge') || qLower.includes('make bigger') || qLower.includes('make larger')) {
                if (qLower.includes('arc') || qLower.includes('reactor') || qLower.includes('logo')) {
                    const arc = document.getElementById('arcReactor');
                    arc.style.transform = arc.style.transform === 'scale(1.4)' ? 'scale(1)' : 'scale(1.4)';
                    speak("Enlarging Arc Reactor core, Sir.");
                } else if (qLower.includes('panel') || qLower.includes('workspace') || qLower.includes('screen')) {
                    document.body.style.transform = document.body.style.transform === 'scale(1.1)' ? 'scale(1)' : 'scale(1.1)';
                    speak("Enlarging main user interface view, Sir.");
                } else {
                    const cards = document.querySelectorAll('.response-card');
                    if (cards.length > 0) {
                        cards.forEach(card => card.classList.toggle('enlarged'));
                        speak("Enlarging current active elements, Sir.");
                    } else {
                        speak("Specify what you would like me to enlarge, Sir.");
                    }
                }
                return;
            }

            if (qLower.includes('clear everything') || qLower.includes('clear screen') || qLower.includes('wipe screen')) {
                document.getElementById('right-content').innerHTML = '<p style="opacity: 0.7;">Screen cleared. Standing by for instructions, Sir.</p>';
                document.getElementById('log').innerText = "SYSTEM: Interface reset complete.";
                document.body.style.transform = 'scale(1)';
                const arc = document.getElementById('arcReactor');
                if (arc) arc.style.transform = 'scale(1)';
                speak("All screen elements and active feeds have been cleared, Sir.");
                return;
            }

            // DEFAULT: LIVE NEWS & SEARCH QUERY
            await fetchLiveNewsAndData(query);
        }
    </script>  
