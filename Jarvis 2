<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JARVIS / E.D.I.T.H. Interface</title>
  <style>
    :root {
      --hud-cyan: #00f3ff;
      --hud-blue: #0066ff;
      --hud-bg: rgba(10, 25, 40, 0.75);
      --hud-border: rgba(0, 243, 255, 0.5);
      --glow-shadow: 0 0 15px rgba(0, 243, 255, 0.3);
    }

    * {
      box-sizing: border-box;
      user-select: none; /* Prevents text selection while dragging */
      -webkit-user-select: none;
    }

    body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle at center, #0B192C 0%, #020813 100%);
      font-family: 'Segoe UI', Roboto, 'Courier New', sans-serif;
      color: var(--hud-cyan);
      overflow: hidden;
      touch-action: none; /* Prevents default browser swipe/scroll behaviors */
    }

    /* Grid overlay for holographic look */
    .grid-overlay {
      position: absolute;
      width: 100%;
      height: 100%;
      background-image: 
        linear-gradient(rgba(0, 243, 255, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 243, 255, 0.05) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
    }

    /* Target Reticle in Center */
    .reticle {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 300px;
      height: 300px;
      border: 1px dashed rgba(0, 243, 255, 0.2);
      border-radius: 50%;
      pointer-events: none;
    }

    .reticle::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 10px;
      height: 10px;
      background: var(--hud-cyan);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      box-shadow: var(--glow-shadow);
    }

    /* Main Container Floating HUD Panel */
    .hud-panel {
      position: absolute;
      top: 80px;
      left: 80px;
      width: 360px;
      background: var(--hud-bg);
      border: 1px solid var(--hud-border);
      border-radius: 8px;
      box-shadow: var(--glow-shadow);
      backdrop-filter: blur(10px);
      padding: 16px;
      touch-action: none;
      transition: box-shadow 0.2s ease;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--hud-border);
      font-size: 0.85rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: bold;
      cursor: move;
    }

    .panel-status {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
    }

    .dot {
      width: 8px;
      height: 8px;
      background: var(--hud-cyan);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--hud-cyan);
    }

    /* Draggable Item Cards */
    .hud-card-container {
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 100px;
    }

    .hud-card {
      background: rgba(0, 102, 255, 0.15);
      border: 1px solid rgba(0, 243, 255, 0.4);
      border-left: 4px solid var(--hud-cyan);
      border-radius: 4px;
      padding: 12px;
      cursor: grab;
      touch-action: none;
      transition: transform 0.1s ease, background 0.2s;
    }

    .hud-card:active {
      cursor: grabbing;
      background: rgba(0, 243, 255, 0.25);
    }

    /* Class applied when a card is extracted into free space */
    .hud-card.detached {
      position: absolute;
      width: 320px;
      z-index: 1000;
      box-shadow: 0 0 20px rgba(0, 243, 255, 0.6);
      border-color: var(--hud-cyan);
    }

    .card-tag {
      font-size: 0.65rem;
      letter-spacing: 1px;
      opacity: 0.8;
      margin-bottom: 4px;
      text-transform: uppercase;
    }

    .card-title {
      font-weight: 600;
      font-size: 0.95rem;
      margin-bottom: 4px;
      color: #fff;
    }

    .card-body {
      font-size: 0.8rem;
      color: #b0e8ff;
      line-height: 1.3;
    }
  </style>
</head>
<body>

  <div class="grid-overlay"></div>
  <div class="reticle"></div>

  <div class="hud-panel" id="mainPanel">
    <div class="panel-header" id="mainHeader">
      <span>// NFL NEWS FEED</span>
      <div class="panel-status"><div class="dot"></div> LIVE</div>
    </div>

    <div class="hud-card-container" id="cardContainer">
      
      <div class="hud-card">
        <div class="card-tag">NFL UPDATE #01</div>
        <div class="card-title">Super Bowl LIX Highlights</div>
        <div class="card-body">Tactical breakdown and key metrics from recent postseason play.</div>
      </div>

      <div class="hud-card">
        <div class="card-tag">NFL UPDATE #02</div>
        <div class="card-title">Draft Prospects Matrix</div>
        <div class="card-body">Top 10 rookie prospects analyzed for upcoming team selections.</div>
      </div>

      <div class="hud-card">
        <div class="card-tag">NFL UPDATE #03</div>
        <div class="card-title">Injury & Roster Reports</div>
        <div class="card-body">Real-time update on active roster adjustments and telemetry.</div>
      </div>

    </div>
  </div>

  <script>
    // Universal Drag Handler using Pointer Events (Mouse + Touch)
    function enableDrag(element, handle = element) {
      let active = false;
      let currentX, currentY, initialX, initialY;
      let xOffset = 0, yOffset = 0;

      handle.addEventListener("pointerdown", pointerStart);

      function pointerStart(e) {
        // Prevent default touch behaviors
        e.preventDefault();

        // If card is inside container, detach it into absolute floating position on grab
        if (element.classList.contains("hud-card") && !element.classList.contains("detached")) {
          const rect = element.getBoundingClientRect();
          
          element.classList.add("detached");
          document.body.appendChild(element); // Move directly to screen overlay level

          element.style.left = rect.left + "px";
          element.style.top = rect.top + "px";
          xOffset = rect.left;
          yOffset = rect.top;
        } else if (!element.classList.contains("detached")) {
          xOffset = element.offsetLeft;
          yOffset = element.offsetTop;
        }

        initialX = e.clientX - xOffset;
        initialY = e.clientY - yOffset;

        active = true;
        handle.setPointerCapture(e.pointerId);

        handle.addEventListener("pointermove", pointerMove);
        handle.addEventListener("pointerup", pointerEnd);
        handle.addEventListener("pointercancel", pointerEnd);
      }

      function pointerMove(e) {
        if (!active) return;
        e.preventDefault();

        currentX = e.clientX - initialX;
        currentY = e.clientY - initialY;

        xOffset = currentX;
        yOffset = currentY;

        element.style.left = currentX + "px";
        element.style.top = currentY + "px";
      }

      function pointerEnd(e) {
        if (!active) return;
        active = false;

        handle.releasePointerCapture(e.pointerId);
        handle.removeEventListener("pointermove", pointerMove);
        handle.removeEventListener("pointerup", pointerEnd);
        handle.removeEventListener("pointercancel", pointerEnd);
      }
    }

    // 1. Enable whole main panel dragging via its header bar
    const mainPanel = document.getElementById("mainPanel");
    const mainHeader = document.getElementById("mainHeader");
    enableDrag(mainPanel, mainHeader);

    // 2. Enable dragging on all cards inside container
    const cards = document.querySelectorAll(".hud-card");
    cards.forEach(card => enableDrag(card));
  </script>
</body>
</html>
