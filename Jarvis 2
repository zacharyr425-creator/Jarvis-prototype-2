<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>J.A.R.V.I.S. Core Interface v4.0</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Share+Tech+Mono&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        html, body {
            width: 100%;
            height: 100%;
            background-color: #030a16;
            color: #00f0ff;
            font-family: 'Share Tech Mono', monospace;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        body::before {
            content: " ";
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 10;
            background-size: 100% 3px, 6px 100%;
            pointer-events: none;
        }

        #loader {
            position: fixed;
            inset: 0;
            background-color: #02060e;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 999;
            transition: opacity 0.8s ease;
        }

        .loader-ring {
            width: 90px;
            height: 90px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            box-shadow: 0 0 15px #00f0ff;
        }

        .loader-text {
            margin-top: 20px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
            animation: pulse 1.5s infinite;
        }

        #hud-container {
            flex: 1;
            width: 100vw;
            height: 100vh;
            border: 1px solid rgba(0, 240, 255, 0.3);
            box-shadow: inset 0 0 20px rgba(0, 240, 255, 0.15);
            background: rgba(4, 18, 38, 0.6);
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            padding: 10px;
            gap: 10px;
            position: relative;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            padding-bottom: 5px;
            height: 35px;
            z-index: 20;
        }

        .system-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            text-shadow: 0 0 10px #00f0ff;
        }

        .workspace {
            flex: 1;
            position: relative;
            overflow: hidden;
            width: 100%;
            height: 100%;
        }

        /* Center Arc Reactor Dynamic Background */
        .arc-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            z-index: 1;
            opacity: 0.7;
        }

        .arc-reactor {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            border: 2px dashed #00f0ff;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: spin 20s linear infinite;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.4);
        }

        .arc-core {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            background: radial-gradient(circle, #ffffff 0%, #00f0ff 60%, rgba(0,240,255,0) 100%);
            box-shadow: 0 0 30px #00f0ff;
            animation: pulse 2s ease-in-out infinite;
        }

        /* Floating Draggable Panels */
        .hud-panel {
            position: absolute;
            width: 300px;
            max-height: 350px;
            background: rgba(4, 20, 40, 0.85);
            border: 1px solid #00f0ff;
            border-radius: 6px;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
            font-size: 0.85rem;
            line-height: 1.4;
            display: flex;
            flex-direction: column;
            z-index: 50;
            overflow: hidden;
            touch-action: none;
        }

        .panel-header {
            background: rgba(0, 240, 255, 0.2);
            padding: 8px 10px;
            cursor: move;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #00f0ff;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            color: #ffffff;
            text-shadow: 0 0 8px #00f0ff;
            text-transform: uppercase;
        }

        .close-btn {
            background: transparent;
            border: none;
            color: #ff4d4d;
            font-weight: bold;
            cursor: pointer;
            padding: 0 4px;
            font-size: 0.9rem;
        }

        .panel-body {
            padding: 10px;
            overflow-y: auto;
            flex: 1;
            user-select: text;
        }

        .news-card {
            background: rgba(0, 240, 255, 0.05);
            border-left: 3px solid #00f0ff;
            padding: 8px;
            margin-bottom: 10px;
            border-radius: 0 4px 4px 0;
        }

        .news-card strong {
            color: #ffffff;
            display: block;
            margin-bottom: 4px;
            font-size: 0.88rem;
        }

        .news-card p {
            color: #b0efff;
            font-size: 0.8rem;
            margin-bottom: 6px;
        }

        .news-card a {
            color: #00f0ff;
            text-decoration: underline;
            font-size: 0.75rem;
            font-weight: bold;
        }

        .terminal-area {
            display: flex;
            flex-direction: column;
            gap: 6px;
            height: 90px;
            z-index: 20;
        }

        .log-box {
            flex: 1;
            overflow-y: auto;
            color: #7df9ff;
            font-size: 0.85rem;
            text-shadow: 0 0 5px #00f0ff;
            background: rgba(0, 0, 0, 0.3);
            padding: 6px;
            border-radius: 4px;
            border: 1px solid rgba(0, 240, 255, 0.2);
        }

        .controls {
            display: flex;
            gap: 8px;
        }

        input[type="text"] {
            flex: 1;
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 10px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.9rem;
            outline: none;
            border-radius: 4px;
            user-select: text;
        }

        button {
            background: rgba(0, 240, 255, 0.25);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 10px 14px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            border-radius: 4px;
            transition: all 0.2s;
        }

        button:active {
            background: #00f0ff;
            color: #000;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
        @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
    </style>
</head>
<body>

    <div id="loader">
        <div class="loader-ring"></div>
        <div class="loader-text">INITIALIZING STARK HUD v4.0...</div>
    </div>

    <div id="hud-container">
        <header>
            <div class="system-title">J.A.R.V.I.S.</div>
            <div id="clock">00:00:00</div>
        </header>

        <div id="workspace" class="workspace">
            <div class="arc-container">
                <div class="arc-reactor">
                    <div class="arc-core"></div>
                </div>
            </div>
        </div>

        <div class="terminal-area">
            <div id="log" class="log-box">SYSTEM: Online and awaiting directives...</div>
            <div class="controls">
                <input type="text" id="userInput" placeholder="Ask JARVIS (e.g. 'open sports on left', 'show calendar')..." onkeydown="if(event.key==='Enter') processInput()">
                <button onclick="processInput()">SEND</button>
                <button onclick="startVoice()">MIC</button>
            </div>
        </div>
    </div>

    <script>
        let availableVoices = [];
        let windowOffset = 0;
        let highestZIndex = 100;

        setTimeout(() => {
            const loader = document.getElementById('loader');
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(() => {
                    loader.style.display = 'none';
                    speak("System online. At your service, Sir.");
                }, 500);
            }
        }, 2000);

        setInterval(() => {
            const clock = document.getElementById('clock');
            if (clock) clock.innerText = new Date().toLocaleTimeString();
        }, 1000);

        function speak(text) {
            try {
                if (!('speechSynthesis' in window)) return;
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.pitch = 0.95;
                utterance.rate = 1.0;

                const voices = availableVoices.length ? availableVoices : window.speechSynthesis.getVoices();
                const preferredVoice = voices.find(v => 
                    v.name.includes('Google UK English Male') || 
                    v.name.includes('Natural') || 
                    (v.lang.includes('en-GB') && v.name.includes('Male')) ||
                    v.name.includes('Daniel')
                ) || voices.find(v => v.lang.includes('en-GB')) || voices[0];

                if (preferredVoice) utterance.voice = preferredVoice;
                window.speechSynthesis.speak(utterance);
            } catch (e) {}

            const log = document.getElementById('log');
            if (log) log.innerText = "JARVIS: " + text;
        }

        async function processInput() {
            const inputField = document.getElementById('userInput');
            if (!inputField) return;
            const query = inputField.value.trim();
            if (!query) return;

            inputField.value = '';
            const qLower = query.toLowerCase();

            // Clear layout command
            if (qLower.includes('clear') || qLower.includes('close all')) {
                document.querySelectorAll('.hud-panel').forEach(p => p.remove());
                speak("Clearing all active HUD windows.");
                return;
            }

            // Calendar command
            if (qLower.includes('calendar') || qLower.includes('schedule')) {
                showCalendar();
                return;
            }

            // Side placement check
            let side = 'auto';
            let searchTerm = query;

            if (qLower.includes('left')) {
                side = 'left';
                searchTerm = query.replace(/on the left|on left/gi, '').replace(/open|show|search/gi, '').trim();
            } else if (qLower.includes('right')) {
                side = 'right';
                searchTerm = query.replace(/on the right|on right/gi, '').replace(/open|show|search/gi, '').trim();
            } else {
                searchTerm = query.replace(/open|show|search/gi, '').trim();
            }

            speak("Accessing telemetry for " + searchTerm + ", Sir.");
            await fetchAndRenderData(searchTerm, side);
        }

        function createDraggablePanel(title, side) {
            const workspace = document.getElementById('workspace');
            const panel = document.createElement('div');
            panel.className = 'hud-panel';
            panel.style.zIndex = ++highestZIndex;

            // Position Logic
            const rect = workspace.getBoundingClientRect();
            let topPos = 20 + (windowOffset % 150);
            let leftPos = 20;

            if (side === 'left') {
                leftPos = 20;
            } else if (side === 'right') {
                leftPos = Math.max(20, rect.width - 320);
            } else {
                leftPos = 20 + (windowOffset % 200);
            }
            windowOffset += 30;

            panel.style.top = topPos + 'px';
            panel.style.left = leftPos + 'px';

            panel.innerHTML = `
                <div class="panel-header">
                    <span>${title}</span>
                    <button class="close-btn" onclick="this.closest('.hud-panel').remove()">✕</button>
                </div>
                <div class="panel-body">
                    <p>Connecting to satellite feeds...</p>
                </div>
            `;

            workspace.appendChild(panel);
            makeElementDraggable(panel);

            // Focus panel when clicked
            panel.addEventListener('pointerdown', () => {
                panel.style.zIndex = ++highestZIndex;
            });

            return panel;
        }

        function makeElementDraggable(elmnt) {
            let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
            const header = elmnt.querySelector('.panel-header');

            if (header) {
                header.onpointerdown = dragPointerStart;
            }

            function dragPointerStart(e) {
                e.preventDefault();
                pos3 = e.clientX;
                pos4 = e.clientY;
                document.onpointermove = elementDrag;
                document.onpointerup = closeDragElement;
            }

            function elementDrag(e) {
                e.preventDefault();
                pos1 = pos3 - e.clientX;
                pos2 = pos4 - e.clientY;
                pos3 = e.clientX;
                pos4 = e.clientY;

                elmnt.style.top = (elmnt.offsetTop - pos2) + "px";
                elmnt.style.left = (elmnt.offsetLeft - pos1) + "px";
            }

            function closeDragElement() {
                document.onpointermove = null;
                document.onpointerup = null;
            }
        }

        function showCalendar() {
            const panel = createDraggablePanel('FAMILY CALENDAR', 'left');
            const body = panel.querySelector('.panel-body');
            body.innerHTML = `
                <p style="margin-bottom:10px; color:#7df9ff;">[Calendar Uplink Ready]</p>
                <div style="height:180px; display:flex; align-items:center; justify-content:center; border:1px solid rgba(0,240,255,0.4); border-radius:4px;">
                    <span style="opacity:0.6;">📅 CALENDAR PLACEHOLDER</span>
                </div>
            `;
            speak("Displaying family calendar, Sir.");
        }

        async function fetchAndRenderData(term, side) {
            const panel = createDraggablePanel(term.toUpperCase(), side);
            const body = panel.querySelector('.panel-body');
            const qLower = term.toLowerCase();

            // 1. ESPN Football API
            if (qLower.includes('nfl') || qLower.includes('football') || qLower.includes('sports') || qLower.includes('espn')) {
                try {
                    const espnRes = await fetch('https://site.api.espn.com/apis/site/v2/sports/football/nfl/news');
                    if (espnRes.ok) {
                        const espnData = await espnRes.json();
                        if (espnData.articles && espnData.articles.length > 0) {
                            renderArticles(body, espnData.articles.slice(0, 3).map(a => ({
                                title: a.headline,
                                desc: a.description || 'Live coverage update from ESPN.',
                                link: (a.links && a.links.web) ? a.links.web.href : '#'
                            })));
                            speak("NFL telemetry updated, Sir.");
                            return;
                        }
                    }
                } catch (e) {}
            }

            // 2. Wikipedia API
            try {
                const searchRes = await fetch('https://en.wikipedia.org/w/api.php?action=opensearch&search=' + encodeURIComponent(term) + '&limit=1&namespace=0&format=json&origin=*');
                if (searchRes.ok) {
                    const searchData = await searchRes.json();
                    if (searchData && searchData[1] && searchData[1].length > 0) {
                        const pageTitle = searchData[1][0];
                        const summaryRes = await fetch('https://en.wikipedia.org/api/rest_v1/page/summary/' + encodeURIComponent(pageTitle));
                        if (summaryRes.ok) {
                            const wikiData = await summaryRes.json();
                            if (wikiData.extract) {
                                body.innerHTML = '<p>' + wikiData.extract + '</p>' +
                                    (wikiData.content_urls?.desktop?.page ? '<br><a href="' + wikiData.content_urls.desktop.page + '" target="_blank" style="color:#00f0ff;">VIEW SOURCE ARTICLE ➔</a>' : '');
                                const spokenText = wikiData.extract.length > 140 ? wikiData.extract.substring(0, 140) + '...' : wikiData.extract;
                                speak(spokenText);
                                return;
                            }
                        }
                    }
                }
            } catch (e) {}

            // Fallback
            body.innerHTML = 
                '<p>• Query Processed: "' + term + '"</p>' +
                '<p>• Analysis complete. Launching search option...</p>' +
                '<br><a href="https://www.google.com/search?q=' + encodeURIComponent(term) + '" target="_blank" style="color:#00f0ff; font-weight:bold;">LAUNCH WEB SEARCH ➔</a>';
            
            speak("Telemetry analyzed for " + term + ", Sir.");
        }

        function renderArticles(container, items) {
            let html = '';
            items.forEach(item => {
                html += '<div class="news-card">' +
                            '<strong>' + item.title + '</strong>' +
                            '<p>' + item.desc + '</p>' +
                            '<a href="' + item.link + '" target="_blank">READ ARTICLE ➔</a>' +
                        '</div>';
            });
            container.innerHTML = html;
        }

        function startVoice() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Speech recognition is not supported in this browser.");
                return;
            }

            const recognition = new SpeechRecognition();
            recognition.lang = 'en-US';
            recognition.start();

            const log = document.getElementById('log');
            if (log) log.innerText = "SYSTEM: Listening...";

            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                document.getElementById('userInput').value = transcript;
                processInput();
            };

            recognition.onerror = () => {
                speak("I didn't catch that, Sir.");
            };
        }
    </script>
</body>
</html>
