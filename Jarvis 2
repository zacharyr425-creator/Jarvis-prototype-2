<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>J.A.R.V.I.S. Interactive HUD</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Share+Tech+Mono&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            height: 100%;
            background-color: #030a16;
            color: #00f0ff;
            font-family: 'Share Tech Mono', monospace;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            touch-action: none;
            user-select: none;
            -webkit-user-select: none;
        }

        body::before {
            content: " ";
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 10;
            background-size: 100% 3px, 6px 100%;
            pointer-events: none;
        }

        #loader {
            position: fixed;
            inset: 0;
            background-color: #02060e;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 999;
            transition: opacity 0.5s ease;
        }

        .loader-ring {
            width: 80px;
            height: 80px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            box-shadow: 0 0 15px #00f0ff;
        }

        .loader-text {
            margin-top: 15px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.85rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
        }

        #hud-container {
            flex: 1;
            width: 100vw;
            height: 100vh;
            border: 1px solid rgba(0, 240, 255, 0.3);
            background: rgba(4, 18, 38, 0.6);
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            padding: 10px;
            gap: 10px;
            position: relative;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            padding-bottom: 5px;
            height: 35px;
            z-index: 20;
        }

        .system-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            text-shadow: 0 0 10px #00f0ff;
        }

        .workspace {
            flex: 1;
            position: relative;
            overflow: hidden;
            width: 100%;
            height: 100%;
        }

        .hud-panel {
            position: absolute;
            width: 300px;
            max-width: 85vw;
            max-height: 65vh;
            overflow-y: auto;
            background: rgba(0, 240, 255, 0.12);
            border: 1px solid #00f0ff;
            padding: 10px;
            border-radius: 6px;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.25);
            font-size: 0.8rem;
            line-height: 1.35;
            backdrop-filter: blur(8px);
            z-index: 30;
            touch-action: none;
            transition: width 0.3s ease, height 0.3s ease;
        }

        .hud-panel.expanded {
            width: 340px;
            max-width: 92vw;
            max-height: 75vh;
            border-color: #ffffff;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.6);
        }

        .drag-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0, 240, 255, 0.3);
            color: #ffffff;
            padding: 6px 8px;
            margin: -10px -10px 8px -10px;
            border-bottom: 1px solid #00f0ff;
            border-radius: 5px 5px 0 0;
            cursor: move;
            touch-action: none;
            sticky: top;
        }

        .drag-handle {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 1px;
            flex-grow: 1;
        }

        .header-actions {
            display: flex;
            gap: 4px;
        }

        .action-btn {
            background: rgba(0, 240, 255, 0.3);
            border: 1px solid #00f0ff;
            color: #fff;
            border-radius: 3px;
            padding: 1px 6px;
            font-size: 0.65rem;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
        }

        .close-btn {
            background: rgba(255, 0, 85, 0.6);
            border: 1px solid #ff0055;
        }

        .hud-panel h3 {
            font-family: 'Orbitron', sans-serif;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            margin-bottom: 6px;
            padding-bottom: 4px;
            font-size: 0.85rem;
            color: #ffffff;
            text-shadow: 0 0 8px #00f0ff;
            text-transform: uppercase;
        }

        .info-card {
            background: rgba(0, 240, 255, 0.08);
            border-left: 3px solid #00f0ff;
            padding: 8px;
            margin-bottom: 8px;
            border-radius: 0 4px 4px 0;
            cursor: pointer;
            transition: background 0.2s;
        }

        .info-card:hover, .info-card:active {
            background: rgba(0, 240, 255, 0.2);
        }

        .info-card strong {
            color: #ffffff;
            display: block;
            margin-bottom: 4px;
            font-size: 0.8rem;
        }

        .info-card p {
            color: #b0efff;
            font-size: 0.75rem;
        }

        .arc-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            z-index: 15;
        }

        .arc-reactor {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 2px dashed #00f0ff;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: spin 20s linear infinite;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
        }

        .arc-core {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: radial-gradient(circle, #ffffff 0%, #00f0ff 60%, rgba(0,240,255,0) 100%);
            box-shadow: 0 0 25px #00f0ff;
            animation: pulse 2s ease-in-out infinite;
        }

        .terminal-area {
            display: flex;
            flex-direction: column;
            gap: 6px;
            height: 90px;
            z-index: 20;
        }

        .log-box {
            flex: 1;
            overflow-y: auto;
            color: #7df9ff;
            font-size: 0.8rem;
            text-shadow: 0 0 5px #00f0ff;
            background: rgba(0, 0, 0, 0.5);
            padding: 6px;
            border-radius: 4px;
            border: 1px solid rgba(0, 240, 255, 0.2);
        }

        .controls {
            display: flex;
            gap: 6px;
        }

        input[type="text"] {
            flex: 1;
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 8px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.85rem;
            outline: none;
            border-radius: 4px;
            user-select: text;
            -webkit-user-select: text;
        }

        button {
            background: rgba(0, 240, 255, 0.25);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 8px 12px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            border-radius: 4px;
        }

        button:active {
            background: #00f0ff;
            color: #000;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
        @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
    </style>
</head>
<body>

    <div id="loader">
        <div class="loader-ring"></div>
        <div class="loader-text">INITIALIZING STARK HUD...</div>
    </div>

    <div id="hud-container">
        <header>
            <div class="system-title">J.A.R.V.I.S.</div>
            <div id="clock">00:00:00</div>
        </header>

        <div id="workspace" class="workspace">
            <div class="arc-container">
                <div class="arc-reactor">
                    <div class="arc-core"></div>
                </div>
            </div>
        </div>

        <div class="terminal-area">
            <div id="log" class="log-box">SYSTEM: Online and awaiting directives...</div>
            <div class="controls">
                <input type="text" id="userInput" placeholder="Ask JARVIS (e.g., 'NBA news', 'White House', 'enlarge')..." onkeydown="if(event.key==='Enter') processInput()">
                <button onclick="processInput()">SEND</button>
                <button onclick="startVoice()">MIC</button>
            </div>
        </div>
    </div>

    <script>
        let topZIndex = 100;
        let activePanel = null;

        // --- Touch & Mouse Drag Engine ---
        function makeDraggable(element) {
            const handle = element.querySelector('.drag-header') || element;
            let startX = 0, startY = 0, initialX = 0, initialY = 0;

            function onStart(e) {
                if (e.target.classList.contains('action-btn') || e.target.classList.contains('close-btn')) return;

                topZIndex++;
                element.style.zIndex = topZIndex;
                activePanel = element;

                const touch = e.touches ? e.touches[0] : e;
                startX = touch.clientX;
                startY = touch.clientY;

                initialX = element.offsetLeft;
                initialY = element.offsetTop;

                window.addEventListener('mousemove', onMove);
                window.addEventListener('mouseup', onEnd);
                window.addEventListener('touchmove', onMove, { passive: false });
                window.addEventListener('touchend', onEnd);
            }

            function onMove(e) {
                if (e.cancelable) e.preventDefault();
                const touch = e.touches ? e.touches[0] : e;

                const dx = touch.clientX - startX;
                const dy = touch.clientY - startY;

                element.style.left = (initialX + dx) + 'px';
                element.style.top = (initialY + dy) + 'px';
                element.style.right = 'auto';
            }

            function onEnd() {
                window.removeEventListener('mousemove', onMove);
                window.removeEventListener('mouseup', onEnd);
                window.removeEventListener('touchmove', onMove);
                window.removeEventListener('touchend', onEnd);
            }

            handle.addEventListener('mousedown', onStart);
            handle.addEventListener('touchstart', onStart, { passive: false });
        }

        // --- Clock & Loader Setup ---
        setTimeout(() => {
            const loader = document.getElementById('loader');
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(() => loader.style.display = 'none', 500);
            }
            speak("System online, Sir. Awaiting input.");
        }, 1200);

        setInterval(() => {
            const clock = document.getElementById('clock');
            if (clock) clock.innerText = new Date().toLocaleTimeString();
        }, 1000);

        function speak(text) {
            const log = document.getElementById('log');
            if (log) log.innerText = "JARVIS: " + text;

            try {
                if (!('speechSynthesis' in window)) return;
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.pitch = 0.95;
                utterance.rate = 1.0;
                window.speechSynthesis.speak(utterance);
            } catch (e) {}
        }

        // --- Panel Repositioning Mechanics ---
        function applyPanelPosition(panel, pos) {
            const workspace = document.getElementById('workspace');
            const wWidth = workspace.clientWidth;
            const wHeight = workspace.clientHeight;
            const pWidth = Math.min(300, wWidth * 0.85);
            const pHeight = 220;

            switch (pos) {
                case 'left':
                    panel.style.left = '10px';
                    panel.style.top = Math.max(10, (wHeight - pHeight) / 2) + 'px';
                    break;
                case 'right':
                    panel.style.left = Math.max(10, wWidth - pWidth - 10) + 'px';
                    panel.style.top = Math.max(10, (wHeight - pHeight) / 2) + 'px';
                    break;
                case 'top':
                    panel.style.left = Math.max(10, (wWidth - pWidth) / 2) + 'px';
                    panel.style.top = '10px';
                    break;
                case 'bottom':
                    panel.style.left = Math.max(10, (wWidth - pWidth) / 2) + 'px';
                    panel.style.top = Math.max(10, wHeight - pHeight - 10) + 'px';
                    break;
                case 'middle':
                case 'center':
                default:
                    panel.style.left = Math.max(10, (wWidth - pWidth) / 2) + 'px';
                    panel.style.top = Math.max(10, (wHeight - pHeight) / 2) + 'px';
                    break;
            }
        }

        function toggleEnlarge(btn) {
            const panel = btn.closest('.hud-panel');
            panel.classList.toggle('expanded');
            btn.innerText = panel.classList.contains('expanded') ? 'SHRINK' : 'MAX';
        }

        function createPanel(titleHTML, pos = 'right') {
            const workspace = document.getElementById('workspace');
            const panel = document.createElement('div');
            panel.className = 'hud-panel';
            topZIndex++;
            panel.style.zIndex = topZIndex;

            panel.innerHTML = `
                <div class="drag-header">
                    <span class="drag-handle">::: DRAG :::</span>
                    <div class="header-actions">
                        <button class="action-btn" onclick="toggleEnlarge(this)">MAX</button>
                        <button class="action-btn close-btn" onclick="this.closest('.hud-panel').remove()">X</button>
                    </div>
                </div>
                ${titleHTML}
            `;

            workspace.appendChild(panel);
            makeDraggable(panel);
            applyPanelPosition(panel, pos);
            activePanel = panel;
            return panel;
        }

        // --- Command & NLP Engine ---
        async function processInput() {
            const inputField = document.getElementById('userInput');
            if (!inputField) return;
            const rawText = inputField.value.trim();
            if (!rawText) return;

            inputField.value = '';
            const textLower = rawText.toLowerCase();

            // 1. Clear Directive
            if (textLower.includes('clear') || textLower.includes('close')) {
                document.querySelectorAll('.hud-panel').forEach(p => p.remove());
                speak("Cleared active HUD windows.");
                return;
            }

            // 2. Enlarge / Resize Directive
            if (textLower.includes('enlarge') || textLower.includes('expand') || textLower.includes('make bigger')) {
                if (activePanel) {
                    activePanel.classList.add('expanded');
                    speak("Enlarging telemetry module, Sir.");
                    return;
                }
            }

            // 3. Move / Reposition Directive
            const isMoveOnly = textLower.includes('move') || textLower.includes('put it') || textLower.includes('shift');
            let detectedPos = null;
            if (textLower.includes('left')) detectedPos = 'left';
            else if (textLower.includes('right')) detectedPos = 'right';
            else if (textLower.includes('top')) detectedPos = 'top';
            else if (textLower.includes('bottom')) detectedPos = 'bottom';
            else if (textLower.includes('middle') || textLower.includes('center')) detectedPos = 'middle';

            if (isMoveOnly && activePanel && detectedPos) {
                applyPanelPosition(activePanel, detectedPos);
                speak("Repositioned to the " + detectedPos + ".");
                return;
            }

            // 4. Topic Extraction
            let targetPos = detectedPos || 'right';
            let query = rawText.replace(/hi jarvis|jarvis|move this to the|move to the|put this on the|move this|on the left|on left|on the right|on right|on top|at top|on bottom|at bottom|in the middle|in center|to the left|to the right|show me|tell me about|what is|who is|search for|add the latest|add latest|get latest|news about|news on/gi, '').trim();

            if (!query) query = "Latest News";

            speak("Fetching live telemetry for " + query + ".");
            await fetchUniversalTelemetry(query, targetPos);
        }

        // --- Universal Data Fetching Engine ---
        async function fetchUniversalTelemetry(query, pos) {
            const panel = createPanel(`<h3>TELEMETRY: ${query.toUpperCase()}</h3><p>Querying external nodes...</p>`, pos);
            const qLower = query.toLowerCase();

            // 1. Sports Specific API (NBA & NFL via ESPN)
            if (qLower.includes('nba') || qLower.includes('nfl') || qLower.includes('falcons') || qLower.includes('basketball') || qLower.includes('football')) {
                const league = (qLower.includes('nba') || qLower.includes('basketball')) ? 'basketball/nba' : 'football/nfl';
                try {
                    const espnRes = await fetch(`https://site.api.espn.com/apis/site/v2/sports/${league}/news`);
                    if (espnRes.ok) {
                        const espnData = await espnRes.json();
                        if (espnData.articles && espnData.articles.length > 0) {
                            let articlesHTML = `<h3>${league.split('/')[1].toUpperCase()} TELEMETRY</h3>`;
                            espnData.articles.slice(0, 4).forEach(item => {
                                articlesHTML += `
                                    <div class="info-card" onclick="this.classList.toggle('expanded-card')">
                                        <strong>${item.headline}</strong>
                                        <p>${item.description || 'Tap to expand headline detail.'}</p>
                                    </div>
                                `;
                            });
                            panel.innerHTML = `
                                <div class="drag-header">
                                    <span class="drag-handle">::: DRAG :::</span>
                                    <div class="header-actions">
                                        <button class="action-btn" onclick="toggleEnlarge(this)">MAX</button>
                                        <button class="action-btn close-btn" onclick="this.closest('.hud-panel').remove()">X</button>
                                    </div>
                                </div>
                                ${articlesHTML}
                            `;
                            speak(`${league.split('/')[1].toUpperCase()} telemetry loaded, Sir.`);
                            return;
                        }
                    }
                } catch (e) {}
            }

            // 2. Wikipedia API Engine (White House, Science, People, Entities)
            try {
                const wikiRes = await fetch('https://en.wikipedia.org/w/api.php?action=opensearch&search=' + encodeURIComponent(query) + '&limit=1&namespace=0&format=json&origin=*');
                if (wikiRes.ok) {
                    const wikiData = await wikiRes.json();
                    if (wikiData && wikiData[1] && wikiData[1].length > 0) {
                        const pageTitle = wikiData[1][0];
                        const summaryRes = await fetch('https://en.wikipedia.org/api/rest_v1/page/summary/' + encodeURIComponent(pageTitle));
                        if (summaryRes.ok) {
                            const summaryData = await summaryRes.json();
                            if (summaryData.extract) {
                                panel.innerHTML = `
                                    <div class="drag-header">
                                        <span class="drag-handle">::: DRAG :::</span>
                                        <div class="header-actions">
                                            <button class="action-btn" onclick="toggleEnlarge(this)">MAX</button>
                                            <button class="action-btn close-btn" onclick="this.closest('.hud-panel').remove()">X</button>
                                        </div>
                                    </div>
                                    <h3>${summaryData.title.toUpperCase()}</h3>
                                    <div class="info-card">
                                        <p>${summaryData.extract}</p>
                                    </div>
                                `;
                                speak(summaryData.extract.substring(0, 110) + '...');
                                return;
                            }
                        }
                    }
                }
            } catch (e) {}

            // 3. DuckDuckGo Instant Answer Fallback
            try {
                const ddgRes = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(query)}&format=json&origin=*`);
                if (ddgRes.ok) {
                    const ddgData = await ddgRes.json();
                    if (ddgData.AbstractText) {
                        panel.innerHTML = `
                            <div class="drag-header">
                                <span class="drag-handle">::: DRAG :::</span>
                                <div class="header-actions">
                                    <button class="action-btn" onclick="toggleEnlarge(this)">MAX</button>
                                    <button class="action-btn close-btn" onclick="this.closest('.hud-panel').remove()">X</button>
                                </div>
                            </div>
                            <h3>${query.toUpperCase()}</h3>
                            <div class="info-card">
                                <p>${ddgData.AbstractText}</p>
                            </div>
                        `;
                        speak("Data feed synchronized.");
                        return;
                    }
                }
            } catch (e) {}

            // 4. Default Telemetry Readout
            panel.innerHTML = `
                <div class="drag-header">
                    <span class="drag-handle">::: DRAG :::</span>
                    <div class="header-actions">
                        <button class="action-btn" onclick="toggleEnlarge(this)">MAX</button>
                        <button class="action-btn close-btn" onclick="this.closest('.hud-panel').remove()">X</button>
                    </div>
                </div>
                <h3>TELEMETRY: ${query.toUpperCase()}</h3>
                <div class="info-card">
                    <strong>SYSTEM FEED ACTIVE</strong>
                    <p>Live stream established for '${query}'.</p>
                </div>
            `;
            speak("Telemetry readout generated for " + query + ".");
        }

        // --- Voice Mic Interface ---
        function startVoice() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Speech recognition is not supported on this browser.");
                return;
            }

            const recognition = new SpeechRecognition();
            recognition.lang = 'en-US';
            recognition.start();

            const log = document.getElementById('log');
            if (log) log.innerText = "SYSTEM: Listening...";

            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                document.getElementById('userInput').value = transcript;
                processInput();
            };

            recognition.onerror = () => {
                speak("Voice input error, Sir.");
            };
        }
    </script>
</body>
</html>
