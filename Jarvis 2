<!DOCTYPE html>  
<html lang="en">  
<head>  
    <meta charset="UTF-8">  
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">  
    <title>J.A.R.V.I.S. Core Interface v16.0 - Stark OS</title>  
    <style>  
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap');

        * {  
            box-sizing: border-box;  
            margin: 0;
            padding: 0;  
            user-select: none;  
        }  

        html, body {  
            width: 100%;
            height: 100%;  
            background-color: #02060e;  
            color: #00f0ff;  
            font-family: 'Share Tech Mono', monospace;  
            overflow: hidden;  
            display: flex;  
            flex-direction: column;  
        }  

        /* CRT Overlay Filter */
        body::before {  
            content: " ";
            position: absolute;  
            inset: 0;  
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            z-index: 10;  
            background-size: 100% 3px, 6px 100%;  
            pointer-events: none;  
        }  

        #loader {  
            position: fixed;
            inset: 0;  
            background-color: #02060e;  
            display: flex;  
            flex-direction: column;  
            justify-content: center;  
            align-items: center;  
            z-index: 999;  
            transition: opacity 0.8s ease;
        }  

        .loader-ring {  
            width: 100px;
            height: 100px;  
            border: 3px solid transparent;  
            border-top: 3px solid #00f0ff;  
            border-bottom: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;  
            box-shadow: 0 0 20px #00f0ff;
        }  

        .loader-text {  
            margin-top: 25px;
            font-family: 'Orbitron', sans-serif;  
            font-size: 0.9rem;  
            letter-spacing: 3px;  
            color: #00f0ff;
            text-shadow: 0 0 10px #00f0ff;  
            animation: pulse 1.5s infinite;
        }  

        #hud-container {  
            flex: 1;
            width: 100vw;  
            height: 100vh;  
            border: 1px solid rgba(0, 240, 255, 0.3);  
            box-shadow: inset 0 0 30px rgba(0, 240, 255, 0.1);
            background: radial-gradient(circle at center, rgba(4, 20, 45, 0.8) 0%, rgba(2, 6, 14, 0.95) 100%);  
            display: flex;  
            flex-direction: column;  
            padding: 15px;
            gap: 12px;  
            position: relative;
        }  

        header {  
            display: flex;
            justify-content: space-between;  
            align-items: center;  
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);  
            padding-bottom: 8px;  
            height: 40px;
        }  

        .system-title {  
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            font-size: 1.2rem;  
            letter-spacing: 3px;  
            text-shadow: 0 0 12px #00f0ff;
        }  

        #clock {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
        }

        .workspace {  
            flex: 1;
            display: grid;  
            grid-template-columns: 340px 1fr 380px;  
            gap: 15px;  
            position: relative;  
            align-items: center;  
            overflow: hidden;  
        }  

        .hud-panel {  
            background: rgba(0, 240, 255, 0.04);
            border: 1px solid rgba(0, 240, 255, 0.6);  
            padding: 15px;  
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.1), inset 0 0 15px rgba(0, 240, 255, 0.05);  
            height: 100%;  
            overflow-y: auto;
            display: block;  
            font-size: 0.85rem;  
            line-height: 1.5;  
            position: relative;
            z-index: 5;
        }  

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);  
            margin-bottom: 12px;  
            padding-bottom: 6px;
        }

        .hud-panel h3 {  
            font-family: 'Orbitron', sans-serif;
            font-size: 0.95rem;  
            color: #ffffff;  
            text-shadow: 0 0 8px #00f0ff;  
            text-transform: uppercase;  
            letter-spacing: 1px;
            margin: 0;
        }  

        .close-btn {
            background: transparent;
            border: none;
            color: #00f0ff;
            font-family: 'Orbitron', sans-serif;
            font-weight: bold;
            font-size: 0.9rem;
            cursor: pointer;
            padding: 2px 6px;
        }

        .close-btn:hover {
            color: #ff3366;
            text-shadow: 0 0 8px #ff3366;
        }

        /* FREELY DRAGGABLE HOLOGRAPHIC RESPONSE CARDS */
        .response-card {
            background: rgba(2, 10, 25, 0.95);
            border: 1px solid #00f0ff;
            padding: 14px;
            border-radius: 6px;
            position: absolute;
            z-index: 1000;
            width: 320px;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.4);
            cursor: grab;
            touch-action: none;
        }

        .response-card:active {
            cursor: grabbing;
        }

        .response-card:hover {
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.8);
            border-color: #ffffff;
        }

        .response-card .card-source {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            color: #ff007f;
            text-shadow: 0 0 5px #ff007f;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .response-card .card-title {
            font-weight: bold;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .response-card .card-snippet {
            font-size: 0.8rem;
            color: #a2f2ff;
            max-height: 180px;
            overflow-y: auto;
        }

        .card-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 8px;
        }

        .expand-btn, .close-card-btn {
            background: rgba(0, 240, 255, 0.2);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            font-size: 0.7rem;
            padding: 3px 8px;
            cursor: pointer;
            border-radius: 3px;
            font-family: 'Orbitron', sans-serif;
        }

        .expand-btn:hover, .close-card-btn:hover {
            background: #00f0ff;
            color: #000;
        }

        .response-card.enlarged {
            width: 480px !important;
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.9);
            border: 2px solid #00f0ff;
        }

        .vital-row {
            display: flex;
            justify-content: space-between;
            margin: 6px 0;
            padding: 6px;
            background: rgba(0, 240, 255, 0.05);
            border-left: 2px solid #00f0ff;
        }

        .vital-value {
            color: #ffffff;
            font-weight: bold;
        }

        .calendar-section {
            margin-top: 15px;
            border: 1px solid rgba(0, 240, 255, 0.3);
            border-radius: 6px;
            padding: 10px;
            background: rgba(0, 240, 255, 0.02);
            transition: all 0.4s ease;
        }

        .calendar-section.highlight {
            border-color: #00f0ff;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.6);
            background: rgba(0, 240, 255, 0.1);
        }

        .calendar-list {
            margin-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .calendar-item {
            background: rgba(0, 240, 255, 0.08);
            border: 1px solid rgba(0, 240, 255, 0.3);
            padding: 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .calendar-item .event-title {
            color: #fff;
            font-weight: bold;
        }

        .calendar-item .event-date {
            color: #ff007f;
            font-size: 0.75rem;
        }

        .cal-input-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: 10px;
        }

        .cal-input-group input {
            padding: 6px;
            font-size: 0.8rem;
        }

        .site-category {
            margin-top: 12px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            color: #ff007f;
            text-shadow: 0 0 5px #ff007f;
            letter-spacing: 1px;
        }

        .site-links-grid {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-top: 4px;
        }

        .site-link {
            color: #a2f2ff;
            text-decoration: none;
            background: rgba(0, 240, 255, 0.06);
            border: 1px solid rgba(0, 240, 255, 0.2);
            padding: 4px 8px;
            border-radius: 3px;
            font-size: 0.78rem;
            transition: all 0.2s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .site-link:hover, .site-link.highlight-link {
            background: rgba(0, 240, 255, 0.35);
            color: #ffffff;
            border-color: #00f0ff;
            box-shadow: 0 0 12px #00f0ff;
        }

        .logo-container {  
            display: flex;
            justify-content: center;  
            align-items: center;  
            grid-column: 2;  
            position: relative;  
            height: 100%;
        }  

        .arc-reactor {
            position: relative;
            width: 220px;
            height: 220px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .arc-outer-ring {
            position: absolute;
            inset: 0;
            border: 2px dashed rgba(0, 240, 255, 0.5);
            border-radius: 50%;
            animation: spin 20s linear infinite;
        }

        .arc-segment-ring {
            position: absolute;
            inset: 12px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-bottom: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin-reverse 10s linear infinite;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
        }

        .arc-inner-housing {
            position: absolute;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 2px solid rgba(0, 240, 255, 0.8);
            background: rgba(0, 240, 255, 0.05);
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
        }

        .arc-coils {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: repeating-conic-gradient(
                from 0deg,
                #00f0ff 0deg 15deg,
                transparent 15deg 36deg
            );
            opacity: 0.85;
            mask-image: radial-gradient(circle, transparent 52%, black 53%, black 70%, transparent 71%);
            -webkit-mask-image: radial-gradient(circle, transparent 52%, black 53%, black 70%, transparent 71%);
            filter: drop-shadow(0 0 8px #00f0ff);
        }

        .arc-core-glow {
            width: 65px;
            height: 65px;
            background: #ffffff;
            border-radius: 50%;
            box-shadow:  
                0 0 20px #00f0ff,
                0 0 40px #00f0ff,
                0 0 60px #00f0ff;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: pulse 2s infinite ease-in-out;
        }

        .arc-center-label {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.65rem;
            font-weight: 900;
            color: #02060e;
            letter-spacing: 1.5px;
        }

        .terminal-area {  
            display: flex;
            flex-direction: column;  
            gap: 8px;  
            height: 110px;  
        }  

        .log-box {  
            flex: 1;
            overflow-y: auto;  
            color: #7df9ff;  
            font-size: 0.85rem;  
            text-shadow: 0 0 5px #00f0ff;  
            background: rgba(0, 0, 0, 0.5);  
            padding: 8px 12px;
            border-radius: 4px;  
            border: 1px solid rgba(0, 240, 255, 0.3);  
            display: flex;
            align-items: center;
        }  

        .controls {  
            display: flex;
            gap: 10px;  
        }  

        input[type="text"], input[type="date"] {  
            flex: 1;
            background: rgba(0, 240, 255, 0.08);  
            border: 1px solid #00f0ff;  
            color: #00f0ff;  
            padding: 10px 14px;  
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.95rem;  
            outline: none;  
            border-radius: 4px;  
            box-shadow: inset 0 0 10px rgba(0, 240, 255, 0.1);
        }  

        input[type="text"]::placeholder {
            color: rgba(0, 240, 255, 0.5);
        }

        button {  
            background: rgba(0, 240, 255, 0.2);
            border: 1px solid #00f0ff;  
            color: #00f0ff;  
            padding: 10px 18px;  
            cursor: pointer;  
            font-family: 'Orbitron', sans-serif;  
            font-weight: bold;
            font-size: 0.8rem;  
            border-radius: 4px;
            transition: all 0.2s;  
            letter-spacing: 1px;
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
        }  

        button:hover {
            background: rgba(0, 240, 255, 0.4);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.6);
        }

        button:active {  
            background: #00f0ff;
            color: #000;  
        }  

        button.mic-active {
            background: rgba(255, 0, 85, 0.4) !important;
            border-color: #ff0055 !important;
            color: #ffffff !important;
            box-shadow: 0 0 20px #ff0055 !important;
            animation: pulse 1s infinite;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }  
        @keyframes spin-reverse { 100% { transform: rotate(-360deg); } }  
        @keyframes pulse { 0%, 100% { opacity: 0.7; transform: scale(0.98); } 50% { opacity: 1; transform: scale(1.02); } }  
    </style>  
</head>  
<body>  

