<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>J.A.R.V.I.S. Core Interface v4.0</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Share+Tech+Mono&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            height: 100%;
            background-color: #030a16;
            color: #00f0ff;
            font-family: 'Share Tech Mono', monospace;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            touch-action: none; /* Prevents unwanted mobile scrolling while dragging */
        }

        body::before {
            content: " ";
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 10;
            background-size: 100% 3px, 6px 100%;
            pointer-events: none;
        }

        #loader {
            position: fixed;
            inset: 0;
            background-color: #02060e;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 999;
            transition: opacity 0.8s ease;
        }

        .loader-ring {
            width: 90px;
            height: 90px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            box-shadow: 0 0 15px #00f0ff;
        }

        .loader-text {
            margin-top: 20px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
            animation: pulse 1.5s infinite;
        }

        #hud-container {
            flex: 1;
            width: 100vw;
            height: 100vh;
            border: 1px solid rgba(0, 240, 255, 0.3);
            box-shadow: inset 0 0 20px rgba(0, 240, 255, 0.15);
            background: rgba(4, 18, 38, 0.6);
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            padding: 10px;
            gap: 10px;
            position: relative;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            padding-bottom: 5px;
            height: 35px;
            z-index: 20;
        }

        .system-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            text-shadow: 0 0 10px #00f0ff;
        }

        .workspace {
            flex: 1;
            position: relative;
            overflow: hidden;
            width: 100%;
            height: 100%;
        }

        .hud-panel {
            position: absolute;
            width: 300px;
            background: rgba(0, 240, 255, 0.12);
            border: 1px solid #00f0ff;
            padding: 12px;
            border-radius: 6px;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.25);
            font-size: 0.85rem;
            line-height: 1.4;
            backdrop-filter: blur(8px);
            z-index: 30;
            transition: box-shadow 0.2s ease, top 0.3s ease, left 0.3s ease;
        }

        .hud-panel:active {
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.6);
        }

        .drag-handle {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            letter-spacing: 1px;
            background: rgba(0, 240, 255, 0.2);
            color: #ffffff;
            text-align: center;
            padding: 4px;
            margin: -12px -12px 8px -12px;
            border-bottom: 1px solid #00f0ff;
            border-radius: 5px 5px 0 0;
            cursor: grab;
            user-select: none;
            touch-action: none;
        }

        .drag-handle:active {
            cursor: grabbing;
            background: rgba(0, 240, 255, 0.4);
        }

        .hud-panel h3 {
            font-family: 'Orbitron', sans-serif;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            margin-bottom: 8px;
            padding-bottom: 4px;
            font-size: 0.9rem;
            color: #ffffff;
            text-shadow: 0 0 8px #00f0ff;
            text-transform: uppercase;
        }

        .calendar-frame {
            width: 100%;
            height: 200px;
            border: 1px solid rgba(0, 240, 255, 0.4);
            border-radius: 4px;
            background: rgba(0, 0, 0, 0.3);
        }

        .news-card {
            background: rgba(0, 240, 255, 0.05);
            border-left: 3px solid #00f0ff;
            padding: 8px;
            margin-bottom: 10px;
            border-radius: 0 4px 4px 0;
        }

        .news-card strong {
            color: #ffffff;
            display: block;
            margin-bottom: 4px;
            font-size: 0.88rem;
        }

        .news-card p {
            color: #b0efff;
            font-size: 0.8rem;
            margin-bottom: 6px;
        }

        .news-card a {
            color: #00f0ff;
            text-decoration: underline;
            font-size: 0.75rem;
            font-weight: bold;
        }

        .arc-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            z-index: 15;
        }

        .arc-reactor {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 2px dashed #00f0ff;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: spin 20s linear infinite;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
        }

        .arc-core {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: radial-gradient(circle, #ffffff 0%, #00f0ff 60%, rgba(0,240,255,0) 100%);
            box-shadow: 0 0 30px #00f0ff;
            animation: pulse 2s ease-in-out infinite;
        }

        .terminal-area {
            display: flex;
            flex-direction: column;
            gap: 6px;
            height: 95px;
            z-index: 20;
        }

        .log-box {
            flex: 1;
            overflow-y: auto;
            color: #7df9ff;
            font-size: 0.85rem;
            text-shadow: 0 0 5px #00f0ff;
            background: rgba(0, 0, 0, 0.4);
            padding: 6px;
            border-radius: 4px;
            border: 1px solid rgba(0, 240, 255, 0.2);
        }

        .controls {
            display: flex;
            gap: 8px;
        }

        input[type="text"] {
            flex: 1;
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 10px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.9rem;
            outline: none;
            border-radius: 4px;
        }

        button {
            background: rgba(0, 240, 255, 0.25);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 10px 14px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            border-radius: 4px;
            transition: all 0.2s;
        }

        button:active {
            background: #00f0ff;
            color: #000;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
        @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
    </style>
</head>
<body>

    <div id="loader">
        <div class="loader-ring"></div>
        <div class="loader-text">INITIALIZING STARK HUD v4.0...</div>
    </div>

    <div id="hud-container">
        <header>
            <div class="system-title">J.A.R.V.I.S.</div>
            <div id="clock">00:00:00</div>
        </header>

        <div id="workspace" class="workspace">
            <div class="arc-container">
                <div class="arc-reactor">
                    <div class="arc-core"></div>
                </div>
            </div>

            <div id="panel-status" class="hud-panel" style="top: 20px; left: 20px;">
                <div class="drag-handle">::: DRAG :::</div>
                <h3>SYSTEM STATUS</h3>
                <p>• Core Engine: Active</p>
                <p>• Neural Link: Operational</p>
                <p>• Satellite Uplink: Connected</p>
            </div>

            <div id="panel-telemetry" class="hud-panel" style="top: 20px; right: 20px; left: auto;">
                <div class="drag-handle">::: DRAG :::</div>
                <h3>TELEMETRY STREAM</h3>
                <div>Awaiting input query...</div>
            </div>
        </div>

        <div class="terminal-area">
            <div id="log" class="log-box">SYSTEM: Online and awaiting directives...</div>
            <div class="controls">
                <input type="text" id="userInput" placeholder="Ask JARVIS (e.g. 'put sports on left', 'who is Albert Einstein')..." onkeydown="if(event.key==='Enter') processInput()">
                <button onclick="processInput()">SEND</button>
                <button onclick="startVoice()">MIC</button>
            </div>
        </div>
    </div>

    <script>
        let availableVoices = [];
        let topZIndex = 100;

        // --- Drag and Drop Functionality (Touch & Mouse Support) ---
        function makeDraggable(element) {
            const handle = element.querySelector('.drag-handle') || element;
            let startX = 0, startY = 0, initialLeft = 0, initialTop = 0;

            const onStart = (e) => {
                // Elevate panel to the top of stacking order
                topZIndex++;
                element.style.zIndex = topZIndex;

                const event = e.touches ? e.touches[0] : e;
                startX = event.clientX;
                startY = event.clientY;

                const rect = element.getBoundingClientRect();
                const workspaceRect = document.getElementById('workspace').getBoundingClientRect();

                initialLeft = rect.left - workspaceRect.left;
                initialTop = rect.top - workspaceRect.top;

                // Disable CSS transitions during drag for real-time response
                element.style.transition = 'none';

                window.addEventListener('mousemove', onMove);
                window.addEventListener('mouseup', onEnd);
                window.addEventListener('touchmove', onMove, { passive: false });
                window.addEventListener('touchend', onEnd);
            };

            const onMove = (e) => {
                if (e.cancelable) e.preventDefault();
                const event = e.touches ? e.touches[0] : e;

                const deltaX = event.clientX - startX;
                const deltaY = event.clientY - startY;

                element.style.left = `${initialLeft + deltaX}px`;
                element.style.top = `${initialTop + deltaY}px`;
                element.style.right = 'auto'; // Disable CSS right positioning if active
            };

            const onEnd = () => {
                element.style.transition = 'box-shadow 0.2s ease, top 0.3s ease, left 0.3s ease';
                window.removeEventListener('mousemove', onMove);
                window.removeEventListener('mouseup', onEnd);
                window.removeEventListener('touchmove', onMove);
                window.removeEventListener('touchend', onEnd);
            };

            handle.addEventListener('mousedown', onStart);
            handle.addEventListener('touchstart', onStart, { passive: false });
        }

        // Apply drag listeners to initial panels on startup
        document.querySelectorAll('.hud-panel').forEach(makeDraggable);

        // --- System Initialization ---
        setTimeout(() => {
            const loader = document.getElementById('loader');
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(() => {
                    loader.style.display = 'none';
                    speak("System online. At your service, Sir.");
                }, 500);
            }
        }, 2000);

        setInterval(() => {
            const clock = document.getElementById('clock');
            if (clock) clock.innerText = new Date().toLocaleTimeString();
        }, 1000);

        function speak(text) {
            try {
                if (!('speechSynthesis' in window)) return;
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.pitch = 0.95;
                utterance.rate = 1.0;

                const voices = availableVoices.length ? availableVoices : window.speechSynthesis.getVoices();
                const preferredVoice = voices.find(v => 
                    v.name.includes('Google UK English Male') || 
                    v.name.includes('Natural') || 
                    (v.lang.includes('en-GB') && v.name.includes('Male')) ||
                    v.name.includes('Daniel')
                ) || voices.find(v => v.lang.includes('en-GB')) || voices[0];

                if (preferredVoice) utterance.voice = preferredVoice;
                window.speechSynthesis.speak(utterance);
            } catch (e) {}

            const log = document.getElementById('log');
            if (log) log.innerText = "JARVIS: " + text;
        }

        // --- Layout Control Engine ---
        function setPanelPosition(panel, position) {
            const workspace = document.getElementById('workspace');
            const wWidth = workspace.clientWidth;
            const wHeight = workspace.clientHeight;
            const pWidth = 300;
            const pHeight = 220;

            panel.style.right = 'auto'; // Reset right anchor

            switch (position) {
                case 'left':
                    panel.style.left = '20px';
                    panel.style.top = `${(wHeight - pHeight) / 2}px`;
                    break;
                case 'right':
                    panel.style.left = `${wWidth - pWidth - 20}px`;
                    panel.style.top = `${(wHeight - pHeight) / 2}px`;
                    break;
                case 'top':
                    panel.style.left = `${(wWidth - pWidth) / 2}px`;
                    panel.style.top = '20px';
                    break;
                case 'bottom':
                    panel.style.left = `${(wWidth - pWidth) / 2}px`;
                    panel.style.top = `${wHeight - pHeight - 20}px`;
                    break;
                case 'middle':
                case 'center':
                    panel.style.left = `${(wWidth - pWidth) / 2}px`;
                    panel.style.top = `${(wHeight - pHeight) / 2}px`;
                    break;
                default:
                    panel.style.left = `${wWidth - pWidth - 20}px`;
                    panel.style.top = '20px';
            }
        }

        // --- Command Processing ---
        async function processInput() {
            const inputField = document.getElementById('userInput');
            if (!inputField) return;
            const query = inputField.value.trim();
            if (!query) return;

            inputField.value = '';
            const qLower = query.toLowerCase();

            // Clear layout action
            if (qLower.includes('clear') || qLower.includes('close')) {
                document.querySelectorAll('.hud-panel').forEach(p => p.remove());
                speak("Clearing active HUD windows.");
                return;
            }

            // Detect target position in screen space
            let position = 'right';
            if (qLower.includes('left')) position = 'left';
            else if (qLower.includes('right')) position = 'right';
            else if (qLower.includes('top')) position = 'top';
            else if (qLower.includes('bottom')) position = 'bottom';
            else if (qLower.includes('middle') || qLower.includes('center')) position = 'middle';

            // Clean term from movement phrases
            let searchTerm = query.replace(/on the left|on left|to the left|on the right|on right|to the right|on top|at the top|on bottom|at the bottom|in the middle|in center/gi, '')
                                 .replace(/open|show|search|put|move/gi, '').trim();

            if (!searchTerm) searchTerm = "Telemetry";

            // Calendar command
            if (qLower.includes('calendar') || qLower.includes('schedule')) {
                showCalendar(position);
                return;
            }

            speak(`Accessing intelligence for ${searchTerm} on screen, Sir.`);
            await fetchAndRenderData(searchTerm, position);
        }

        function createHudPanel(titleHTML, position) {
            const workspace = document.getElementById('workspace');
            const panel = document.createElement('div');
            panel.className = 'hud-panel';
            topZIndex++;
            panel.style.zIndex = topZIndex;

            panel.innerHTML = `
                <div class="drag-handle">::: DRAG :::</div>
                ${titleHTML}
            `;

            workspace.appendChild(panel);
            makeDraggable(panel);
            setPanelPosition(panel, position);
            return panel;
        }

        function showCalendar(position) {
            const content = `
                <h3>FAMILY CALENDAR</h3>
                <p style="margin-bottom:10px; color:#7df9ff;">[Calendar Uplink Ready - Paste Google Calendar embed URL when available]</p>
                <div class="calendar-frame" style="display:flex; align-items:center; justify-content:center;">
                    <span style="opacity:0.6;">📅 CALENDAR PLACEHOLDER</span>
                </div>
            `;
            createHudPanel(content, position);
            speak("Displaying family calendar, Sir.");
        }

        // --- Expanded Knowledge Engine ---
        async function fetchAndRenderData(term, position) {
            const newPanel = createHudPanel(`<h3>SEARCHING: ${term.toUpperCase()}</h3><p>Connecting to global knowledge feeds...</p>`, position);
            const qLower = term.toLowerCase();

            // 1. ESPN NFL Sports Feed
            if (qLower.includes('nfl') || qLower.includes('football') || qLower.includes('sports') || qLower.includes('espn')) {
                try {
                    const espnRes = await fetch('https://site.api.espn.com/apis/site/v2/sports/football/nfl/news');
                    if (espnRes.ok) {
                        const espnData = await espnRes.json();
                        if (espnData.articles && espnData.articles.length > 0) {
                            renderArticles(newPanel, "NFL TELEMETRY", espnData.articles.slice(0, 3).map(a => ({
                                title: a.headline,
                                desc: a.description || 'Live coverage update from ESPN.',
                                link: (a.links && a.links.web) ? a.links.web.href : '#'
                            })));
                            speak("NFL telemetry updated, Sir.");
                            return;
                        }
                    }
                } catch (e) {}
            }

            // 2. Wikipedia Detailed Knowledge API
            try {
                const searchRes = await fetch('https://en.wikipedia.org/w/api.php?action=opensearch&search=' + encodeURIComponent(term) + '&limit=1&namespace=0&format=json&origin=*');
                if (searchRes.ok) {
                    const searchData = await searchRes.json();
                    if (searchData && searchData[1] && searchData[1].length > 0) {
                        const pageTitle = searchData[1][0];
                        const summaryRes = await fetch('https://en.wikipedia.org/api/rest_v1/page/summary/' + encodeURIComponent(pageTitle));
                        if (summaryRes.ok) {
                            const wikiData = await summaryRes.json();
                            if (wikiData.extract) {
                                newPanel.innerHTML = `
                                    <div class="drag-handle">::: DRAG :::</div>
                                    <h3>${wikiData.title.toUpperCase()}</h3>
                                    <p>${wikiData.extract}</p>
                                    ${wikiData.content_urls?.desktop?.page ? `<br><a href="${wikiData.content_urls.desktop.page}" target="_blank" style="color:#00f0ff;">VIEW SOURCE ARTICLE ➔</a>` : ''}
                                `;
                                const spokenText = wikiData.extract.length > 140 ? wikiData.extract.substring(0, 140) + '...' : wikiData.extract;
                                speak(spokenText);
                                return;
                            }
                        }
                    }
                }
            } catch (e) {}

            // 3. DuckDuckGo Knowledge & Definition Search API (Fallback knowledge source)
            try {
                const ddgRes = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(term)}&format=json&origin=*`);
                if (ddgRes.ok) {
                    const ddgData = await ddgRes.json();
                    if (ddgData.AbstractText) {
                        newPanel.innerHTML = `
                            <div class="drag-handle">::: DRAG :::</div>
                            <h3>${(ddgData.Heading || term).toUpperCase()}</h3>
                            <p>${ddgData.AbstractText}</p>
                            <br><a href="${ddgData.AbstractURL}" target="_blank" style="color:#00f0ff;">VIEW SOURCE ARTICLE ➔</a>
                        `;
                        speak(ddgData.AbstractText.substring(0, 140) + '...');
                        return;
                    }
                }
            } catch (e) {}

            // 4. Web Search Link Fallback
            newPanel.innerHTML = `
                <div class="drag-handle">::: DRAG :::</div>
                <h3>TELEMETRY: ${term.toUpperCase()}</h3>
                <p>• Query Processed: "${term}"</p>
                <p>• Knowledge query complete. Opening direct web search link...</p>
                <br><a href="https://www.google.com/search?q=${encodeURIComponent(term)}" target="_blank" style="color:#00f0ff; font-weight:bold;">LAUNCH WEB SEARCH ➔</a>
            `;
            speak("Telemetry analyzed for " + term + ", Sir.");
        }

        function renderArticles(container, title, items) {
            let html = `<div class="drag-handle">::: DRAG :::</div><h3>${title}</h3>`;
            items.forEach(item => {
                html += `<div class="news-card">
                            <strong>${item.title}</strong>
                            <p>${item.desc}</p>
                            <a href="${item.link}" target="_blank">READ ARTICLE ➔</a>
                        </div>`;
            });
            container.innerHTML = html;
        }

        // --- Voice Command Processing ---
        function startVoice() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Speech recognition is not supported in this browser.");
                return;
            }

            const recognition = new SpeechRecognition();
            recognition.lang = 'en-US';
            recognition.start();

            const log = document.getElementById('log');
            if (log) log.innerText = "SYSTEM: Listening...";

            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                document.getElementById('userInput').value = transcript;
                processInput();
            };

            recognition.onerror = () => {
                speak("I didn't catch that, Sir.");
            };
        }
    </script>
</body>
</html>
