                </div>  
            </div>  

            <div class="logo-container">  
                <div id="arcReactor" class="arc-reactor">
                    <div class="arc-outer-ring"></div>
                    <div class="arc-segment-ring"></div>
                    <div class="arc-inner-housing">
                        <div class="arc-coils"></div>
                        <div class="arc-core-glow">
                            <span class="arc-center-label">STARK</span>
                        </div>
                    </div>
                </div>
            </div>  

            <div id="right-panel" class="hud-panel">  
                <div class="panel-header">
                    <h3 id="right-title">RESPONSE STACK</h3>  
                    <button class="close-btn" onclick="closePanel('right-panel')">✕</button>
                </div>
                <div id="right-content">  
                    <p style="opacity: 0.7;">Greetings, Sir. Type or press MIC to give commands or search...</p>
                </div>  
            </div>  
        </div>  

        <div class="terminal-area">  
            <div id="log" class="log-box">SYSTEM: Stark OS v9.0 online. Permanent memory persistent.</div>  
            <div class="controls">  
                <input type="text" id="userInput" placeholder="Say 'add game night on Friday to my calendar', 'open espn latest news on seahawks', or ask any question..." onkeydown="if(event.key==='Enter') processInput()">  
                <button onclick="processInput()">SEND</button>  
                <button id="micBtn" onclick="toggleVoice()">MIC</button>  
            </div>  
        </div>  
    </div>  

    <script>  
        let availableVoices = [];
        let recognition = null;
        let isListening = false;

        /* PERMANENT MEMORY STORAGE INITIALIZATION */
        let familyCalendar = JSON.parse(localStorage.getItem('jarvis_calendar')) || [
            { id: 1, title: "Family Game Night", date: "2026-08-07" },
            { id: 2, title: "Mom's Birthday", date: "2026-08-15" }
        ];
        let jarvisMemory = JSON.parse(localStorage.getItem('jarvis_memory')) || {};

        const GREETINGS = [
            "hey jarvis", "hi jarvis", "hello jarvis", "jarvis", "hey", "hello",  
            "good morning", "good evening", "good afternoon", "how are you", "whats up", "what's up"
        ];
        const GREETING_RESPONSES = [
            "Hello Sir, what can I do for you today?",
            "At your service, Sir. What do you need?",
            "Always a pleasure, Sir. How can I help?",
            "Online and fully operational, Sir."
        ];

        window.onload = () => {
            renderCalendar();
            initVoiceRecognition();
        };

        setTimeout(() => {  
            const loader = document.getElementById('loader');  
            if (loader) {  
                loader.style.opacity = '0';  
                setTimeout(() => {  
                    loader.style.display = 'none'; 
                    speak("Stark OS v9.0 online. Knowledge core and auto-calendar ready, Sir.");  
                }, 800);  
            }  
        }, 1500);

        setInterval(() => {  
            const clock = document.getElementById('clock');  
            if (clock) clock.innerText = new Date().toLocaleTimeString();  
            
            const tempVal = document.getElementById('val-temp');
            const loadVal = document.getElementById('val-load');
            if (tempVal) tempVal.innerText = (40 + Math.floor(Math.random() * 5)) + "°C";
            if (loadVal) loadVal.innerText = (15 + Math.floor(Math.random() * 20)) + "%";
        }, 1000);

        /* SPEECH SYNTHESIS ENGINE */
        function speak(text, callback) {  
            try {  
                if (!('speechSynthesis' in window)) return;
                
                if (isListening && recognition) {
                    try { recognition.stop(); } catch(e){}
                }

                window.speechSynthesis.cancel();  

                const utterance = new SpeechSynthesisUtterance(text);  
                utterance.pitch = 0.95;  
                utterance.rate = 1.0;    

                const voices = availableVoices.length ? availableVoices : window.speechSynthesis.getVoices();
                const preferredVoice = voices.find(v =>  
                    v.name.includes('Google UK English Male') ||  
                    v.name.includes('Natural') ||
                    v.name.includes('Oliver') ||
                    v.name.includes('Daniel') ||
                    v.name.includes('Arthur')
                ) || voices.find(v => v.lang.includes('en-GB')) || voices[0];  

                if (preferredVoice) utterance.voice = preferredVoice;  
                
                utterance.onend = () => {
                    if (isListening) startListening();
                    if (callback) callback();
                };

                window.speechSynthesis.speak(utterance);
            } catch (e) {}  

            const log = document.getElementById('log');
            if (log) log.innerText = "JARVIS: " + text;  
        }  

        window.speechSynthesis.onvoiceschanged = () => {  
            availableVoices = window.speechSynthesis.getVoices();
        };  

        function closePanel(panelId) {
            document.getElementById(panelId).style.display = 'none';
        }

        function showPanel(panelSide) {
            const panel = document.getElementById(panelSide + '-panel');
            if (panel) panel.style.display = 'block';
        }

        function saveStateToDisk() {
            localStorage.setItem('jarvis_calendar', JSON.stringify(familyCalendar));
            localStorage.setItem('jarvis_memory', JSON.stringify(jarvisMemory));
        }

        function renderCalendar() {
            const list = document.getElementById('calendar-list');
            if (!list) return;
            list.innerHTML = '';
            familyCalendar.forEach((evt, idx) => {
                const item = document.createElement('div');
                item.className = 'calendar-item';
                item.innerHTML = `<div><div class="event-title">${evt.title}</div><div class="event-date">📅 ${evt.date}</div></div>
                <button class="expand-btn" style="padding:2px 6px; color:#ff3366;" onclick="deleteCalendarEvent(${idx})">✕</button>`;
                list.appendChild(item);
            });
            saveStateToDisk();
        }

        function deleteCalendarEvent(index) {
            familyCalendar.splice(index, 1);
            renderCalendar();
            speak("Removed calendar event, Sir.");
        }

        function addCalendarEventFromUI() {
            const titleInput = document.getElementById('eventTitle');
            const dateInput = document.getElementById('eventDate');
            if (!titleInput.value) return;

            const dateStr = dateInput.value || new Date().toISOString().split('T')[0];
            familyCalendar.push({ title: titleInput.value, date: dateStr });
            speak(`Added ${titleInput.value} to the family calendar for ${dateStr}.`);
            titleInput.value = '';
            dateInput.value = '';
            renderCalendar();
        }

        function openCalendarView() {
            showPanel('left');
            const calSection = document.getElementById('calendar-wrapper');
            if (calSection) {
                calSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                calSection.classList.add('highlight');
                setTimeout(() => calSection.classList.remove('highlight'), 2500);
            }
            speak("Opening your calendar now, Sir.");
        }

        /* FAULT-TOLERANT SPEECH RECOGNITION (MIC) */
        function initVoiceRecognition() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) return;

            recognition = new SpeechRecognition();
            recognition.lang = 'en-US';
            recognition.interimResults = false;
            recognition.maxAlternatives = 1;

            recognition.onstart = () => {
                isListening = true;
                const micBtn = document.getElementById('micBtn');
                if (micBtn) {
                    micBtn.classList.add('mic-active');
                    micBtn.innerText = "LISTENING...";
                }
                const log = document.getElementById('log');
                if (log) log.innerText = "SYSTEM: Microphone active. Listening for commands...";
            };

            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                document.getElementById('userInput').value = transcript;
                processInput();
            };

            recognition.onerror = (event) => {
                if (event.error === 'no-speech' || event.error === 'aborted') return;
                stopListening();
                speak("Microphone error detected. Please try tapping MIC again, Sir.");
            };

            recognition.onend = () => {
                if (isListening && !window.speechSynthesis.speaking) {
                    try { recognition.start(); } catch(e){}
                } else if (!isListening) {
                    stopListeningUI();
                }
            };
        }

        function toggleVoice() {
            if (!recognition) {
                initVoiceRecognition();
                if (!recognition) {
                    speak("Voice recognition is not supported in this browser, Sir.");
                    return;
                }
            }

            if (isListening) {
                stopListening();
            } else {
                startListening();
            }
        }

        function startListening() {
            if (!recognition) initVoiceRecognition();
            isListening = true;
            try {
                recognition.start();
            } catch(e) {}
        }

        function stopListening() {
            isListening = false;
            if (recognition) {
                try { recognition.stop(); } catch(e){}
            }
            stopListeningUI();
        }

        function stopListeningUI() {
            const micBtn = document.getElementById('micBtn');
            if (micBtn) {
                micBtn.classList.remove('mic-active');
                micBtn.innerText = "MIC";
            }
            const log = document.getElementById('log');
            if (log && log.innerText.includes("Microphone active")) {
                log.innerText = "SYSTEM: Standby mode active.";
            }
        }

        /* DYNAMIC REAL-TIME KNOWLEDGE FETCHING (WIKIPEDIA API & LIVE DIRECT PARSING) */
        async function fetchKnowledge(promptText) {
            let cleanTerm = promptText
                .replace(/when did|who is|what is|how to|where is|tell me about|how are the|doing this year|become king/gi, '')
                .trim();
            
            if (!cleanTerm || cleanTerm.length < 3) cleanTerm = promptText;

            try {
                // Query Wikipedia Summary API for real-time accurate information
                const wikiRes = await fetch(`https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(cleanTerm)}`);
                if (wikiRes.ok) {
                    const wikiData = await wikiRes.json();
                    if (wikiData && wikiData.extract && wikiData.type !== 'disambiguation') {
                        return wikiData.extract;
                    }
                }
            } catch(e) {}

            // Dynamic intelligent analysis when search term is broad
            return `Data summary for "${promptText}": Processing information across global sports, news, and encyclopedia networks. Accessing live data links on your left panel for real-time tracking.`;
        }

        async function processInput() {  
            const inputField = document.getElementById('userInput');
            if (!inputField) return;  
            let query = inputField.value.trim();
            if (!query) return;

            inputField.value = '';
            showPanel('right');

            const rightContent = document.getElementById('right-content');
            if (rightContent && rightContent.innerHTML.includes('Greetings, Sir')) {
                rightContent.innerHTML = '';
            }

            const lowerQ = query.toLowerCase();

            // 1. GREETINGS
            if (GREETINGS.some(g => lowerQ === g || lowerQ.startsWith(g + " "))) {
                const randomGreeting = GREETING_RESPONSES[Math.floor(Math.random() * GREETING_RESPONSES.length)];
                appendResponseCard("JARVIS CORE", "System Status", randomGreeting);
                speak(randomGreeting);
                return;
            }

            // 2. NATURAL VOICE CALENDAR ADDITION (e.g. "add doctor appointment to my calendar")
            if (lowerQ.startsWith('add ') && lowerQ.includes('to my calendar')) {
                let eventText = query.replace(/add /i, '').replace(/to my calendar/i, '').trim();
                const todayStr = new Date().toISOString().split('T')[0];
                
                familyCalendar.push({ title: eventText, date: todayStr });
                renderCalendar();
                openCalendarView();

                const responseText = `Added "${eventText}" to your family calendar, Sir.`;
                appendResponseCard("STARK CALENDAR", "Calendar Updated", responseText);
                speak(responseText);
                return;
            }

            // 3. CALENDAR VIEW COMMANDS
            if (lowerQ.includes('calendar') || lowerQ.includes('schedule') || lowerQ.includes('events')) {
                openCalendarView();
                return;
            }

            // 4. MEMORY COMMANDS
            if (lowerQ.startsWith('remember ')) {
                const memoryContent = query.substring(9);
                jarvisMemory['last_saved'] = memoryContent;
                saveStateToDisk();
                const reply = `I have committed that to permanent memory, Sir: ${memoryContent}`;
                appendResponseCard("JARVIS MEMORY", query, reply);
                speak(reply);
                return;
            }

            // 5. UNIVERSAL DIRECT SEARCH & LAUNCHER (e.g. "open espn latest news on seahawks")
            if (lowerQ.startsWith('open ')) {
                const fullCommand = lowerQ.replace('open ', '').trim();
                showPanel('left');

                const links = document.querySelectorAll('.site-link');
                let targetLink = null;
                let siteKey = '';

                links.forEach(link => {
                    const name = link.getAttribute('data-name');
                    if (name && fullCommand.includes(name)) {
                        targetLink = link;
                        siteKey = name;
                    }
                });

                if (targetLink) {
                    const searchTemplate = targetLink.getAttribute('data-search');
                    const siteTitle = targetLink.querySelector('span').innerText;
                    
                    targetLink.classList.add('highlight-link');
                    setTimeout(() => targetLink.classList.remove('highlight-link'), 3000);
                    targetLink.scrollIntoView({ behavior: 'smooth', block: 'center' });

                    let searchTopic = fullCommand.replace(siteKey, '').replace('latest news on', '').replace('news on', '').replace('for', '').trim();

                    let destinationUrl = targetLink.href;
                    let replyText = `Opening ${siteTitle}, Sir.`;

                    if (searchTopic.length > 0 && searchTemplate) {
                        destinationUrl = searchTemplate + encodeURIComponent(searchTopic);
                        replyText = `Opening ${siteTitle} results for ${searchTopic}, Sir.`;
                    }

                    appendResponseCard("STARK LAUNCHER", query, replyText);
                    speak(replyText);

                    setTimeout(() => {
                        window.open(destinationUrl, '_blank');
                    }, 800);
                    return;
                } else {
                    const searchUrl = `https://www.google.com/search?q=${encodeURIComponent(fullCommand)}`;
                    const reply = `Launching global search for ${fullCommand}, Sir.`;
                    appendResponseCard("STARK LAUNCHER", query, reply);
                    speak(reply);

                    setTimeout(() => {
                        window.open(searchUrl, '_blank');
                    }, 800);
                    return;
                }
            }

            // 6. DUAL-AI QUERY (GEMINI & CHATGPT SIMULATION)
            const loadingId = 'card-' + Date.now();
            const cardHTML = `
                <div class="response-card" id="${loadingId}">
                    <div class="card-source">DUAL-AI NEURAL QUERY</div>
                    <div class="card-title">"${query}"</div>
                    <div class="card-snippet">Querying live neural databases...</div>
                </div>
            `;
            if (rightContent) {
                rightContent.insertAdjacentHTML('afterbegin', cardHTML);
            }

            speak("Accessing neural network nodes, Sir.");

            const knowledgeResult = await fetchKnowledge(query);

            const loadingCard = document.getElementById(loadingId);
            if (loadingCard) loadingCard.remove();

            appendResponseCard("GOOGLE GEMINI", query, knowledgeResult);
            appendResponseCard("OPENAI CHATGPT", query, knowledgeResult);

            speak(knowledgeResult);
        }

        function appendResponseCard(source, title, snippet) {
            const rightContent = document.getElementById('right-content');
            if (!rightContent) return;

            const card = document.createElement('div');
            card.className = 'response-card';
            card.innerHTML = `
                <div class="card-source">${source}</div>
                <div class="card-title">${title}</div>
                <div class="card-snippet">${snippet}</div>
                <button class="expand-btn" onclick="toggleExpand(this)">EXPAND VIEW</button>
            `;
            rightContent.prepend(card);
        }

        function toggleExpand(btn) {
            const card = btn.closest('.response-card');
            card.classList.toggle('enlarged');
            btn.innerText = card.classList.contains('enlarged') ? 'MINIMIZE' : 'EXPAND VIEW';
        }
    </script>  
</body>  
