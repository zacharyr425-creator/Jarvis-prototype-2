<!DOCTYPE html>  
<html lang="en">  
<head>  
    <meta charset="UTF-8">  
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">  
    <title>J.A.R.V.I.S. Core Operating System v8.0</title>  
    <style>  
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap');
        * {  
            box-sizing: border-box;  
            margin: 0;
            padding: 0;  
            user-select: none;  
        }  

        html, body {  
            width: 100%;
            height: 100%;  
            background-color: #02060e;  
            color: #00f0ff;  
            font-family: 'Share Tech Mono', monospace;  
            overflow: hidden;  
            display: flex;  
            flex-direction: column;
            transition: transform 0.4s ease;
        }  

        /* CRT Overlay Filter */
        body::before {  
            content: " ";
            position: absolute;  
            inset: 0;  
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            z-index: 10;  
            background-size: 100% 3px, 6px 100%;  
            pointer-events: none;  
        }  

        #loader {  
            position: fixed;
            inset: 0;  
            background-color: #02060e;  
            display: flex;  
            flex-direction: column;  
            justify-content: center;  
            align-items: center;  
            z-index: 999;  
            transition: opacity 0.8s ease;
        }  

        .loader-ring {  
            width: 100px;
            height: 100px;  
            border: 3px solid transparent;  
            border-top: 3px solid #00f0ff;  
            border-bottom: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;  
            box-shadow: 0 0 20px #00f0ff;
        }  

        .loader-text {  
            margin-top: 25px;
            font-family: 'Orbitron', sans-serif;  
            font-size: 0.9rem;  
            letter-spacing: 3px;  
            color: #00f0ff;
            text-shadow: 0 0 10px #00f0ff;  
            animation: pulse 1.5s infinite;
        }  

        #hud-container {  
            flex: 1;
            width: 100vw;  
            height: 100vh;  
            border: 1px solid rgba(0, 240, 255, 0.3);  
            box-shadow: inset 0 0 30px rgba(0, 240, 255, 0.1);
            background: radial-gradient(circle at center, rgba(4, 20, 45, 0.8) 0%, rgba(2, 6, 14, 0.95) 100%);  
            display: flex;  
            flex-direction: column;  
            padding: 15px;
            gap: 12px;  
            position: relative;
        }  

        header {  
            display: flex;
            justify-content: space-between;  
            align-items: center;  
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);  
            padding-bottom: 8px;  
            height: 40px;
        }  

        .system-title {  
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            font-size: 1.2rem;  
            letter-spacing: 3px;  
            text-shadow: 0 0 12px #00f0ff;
        }  

        #clock {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
        }

        .workspace {  
            flex: 1;
            display: grid;  
            grid-template-columns: 340px 1fr 380px;  
            gap: 15px;  
            position: relative;  
            align-items: center;  
            overflow: hidden;  
            transition: all 0.5s ease;
        }  

        .hud-panel {  
            background: rgba(0, 240, 255, 0.04);
            border: 1px solid rgba(0, 240, 255, 0.6);  
            padding: 15px;  
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.1), inset 0 0 15px rgba(0, 240, 255, 0.05);  
            height: 100%;  
            overflow-y: auto;
            display: block;  
            font-size: 0.85rem;  
            line-height: 1.5;  
            position: relative;
            z-index: 5;
            transition: all 0.4s ease;
        }  

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);  
            margin-bottom: 12px;  
            padding-bottom: 6px;
        }

        .hud-panel h3 {  
            font-family: 'Orbitron', sans-serif;
            font-size: 0.95rem;  
            color: #ffffff;  
            text-shadow: 0 0 8px #00f0ff;  
            text-transform: uppercase;  
            letter-spacing: 1px;
            margin: 0;
        }  

        .close-btn {
            background: transparent;
            border: none;
            color: #00f0ff;
            font-family: 'Orbitron', sans-serif;
            font-weight: bold;
            font-size: 0.9rem;
            cursor: pointer;
            padding: 2px 6px;
            box-shadow: none;
        }

        .close-btn:hover {
            color: #ff3366;
            text-shadow: 0 0 8px #ff3366;
            background: transparent;
            box-shadow: none;
        }

        /* RESPONSE CARD STYLING & DRAGGING */
        .response-card {
            background: rgba(0, 240, 255, 0.08);
            border: 1px solid rgba(0, 240, 255, 0.4);
            padding: 12px;
            margin-bottom: 12px;
            border-radius: 6px;
            cursor: grab;
            transition: background 0.2s, box-shadow 0.2s, transform 0.3s ease, width 0.3s ease;
            position: relative;
            z-index: 20;
            touch-action: none;
        }

        .response-card:active {
            cursor: grabbing;
        }

        .response-card:hover {
            background: rgba(0, 240, 255, 0.18);
            border-color: #00f0ff;
            box-shadow: 0 0 12px rgba(0, 240, 255, 0.4);
        }

        .response-card .card-source {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            color: #ff007f;
            text-shadow: 0 0 5px #ff007f;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .response-card .card-title {
            font-weight: bold;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .response-card .card-snippet {
            font-size: 0.8rem;
            color: #a2f2ff;
        }

        .card-actions {
            margin-top: 10px;
            display: flex;
            justify-content: flex-end;
            gap: 6px;
        }

        .expand-btn, .link-btn {
            background: rgba(0, 240, 255, 0.2);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            font-size: 0.7rem;
            padding: 4px 8px;
            cursor: pointer;
            border-radius: 3px;
            font-family: 'Orbitron', sans-serif;
            text-decoration: none;
            display: inline-block;
        }

        .expand-btn:hover, .link-btn:hover {
            background: #00f0ff;
            color: #000;
        }

        .response-card.enlarged {
            width: 100% !important;
            transform: scale(1.02);
            background: rgba(2, 10, 25, 0.95);
            border: 2px solid #00f0ff;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.6);
            padding: 18px;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        /* CENTER CALENDAR MODAL OVERLAY */
        #center-calendar-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.9);
            width: 80%;
            height: 82%;
            background: rgba(2, 8, 20, 0.97);
            border: 2px solid #00f0ff;
            border-radius: 12px;
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.7);
            z-index: 100;
            display: none;
            flex-direction: column;
            padding: 18px;
            transition: all 0.3s ease;
        }

        #center-calendar-overlay.active {
            display: flex;
            transform: translate(-50%, -50%) scale(1);
        }

        .overlay-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.5);
            padding-bottom: 10px;
            margin-bottom: 12px;
        }

        .overlay-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            color: #ffffff;
            text-shadow: 0 0 10px #00f0ff;
        }

        .calendar-frame {
            flex: 1;
            width: 100%;
            border: 1px solid rgba(0, 240, 255, 0.3);
            border-radius: 6px;
            background: #ffffff;
        }

        /* VITALS, CALENDAR, NOTES */
        .vital-row {
            display: flex;
            justify-content: space-between;
            margin: 6px 0;
            padding: 6px;
            background: rgba(0, 240, 255, 0.05);
            border-left: 2px solid #00f0ff;
        }

        .vital-value {
            color: #ffffff;
            font-weight: bold;
        }

        .calendar-list, .notes-list {
            margin-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .calendar-item, .note-item {
            background: rgba(0, 240, 255, 0.08);
            border: 1px solid rgba(0, 240, 255, 0.3);
            padding: 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .calendar-item .event-title, .note-item .note-text {
            color: #fff;
            font-weight: bold;
        }

        .calendar-item .event-date, .note-item .note-date {
            color: #ff007f;
            font-size: 0.75rem;
        }

        .cal-input-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: 10px;
        }

        .cal-input-group input {
            padding: 6px;
            font-size: 0.8rem;
        }

        /* WEBSITES LINK PANEL STYLING */
        .site-category {
            margin-top: 12px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            color: #ff007f;
            text-shadow: 0 0 5px #ff007f;
            letter-spacing: 1px;
        }

        .site-links-grid {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-top: 4px;
        }

        .site-link {
            color: #a2f2ff;
            text-decoration: none;
            background: rgba(0, 240, 255, 0.06);
            border: 1px solid rgba(0, 240, 255, 0.2);
            padding: 4px 8px;
            border-radius: 3px;
            font-size: 0.78rem;
            transition: all 0.2s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .site-link:hover {
            background: rgba(0, 240, 255, 0.25);
            color: #ffffff;
            border-color: #00f0ff;
            box-shadow: 0 0 8px rgba(0, 240, 255, 0.4);
        }

        /* ARC REACTOR LOGO DESIGN */  
        .logo-container {  
            display: flex;
            justify-content: center;  
            align-items: center;  
            grid-column: 2;  
            position: relative;  
            height: 100%;
        }  

        .arc-reactor {
            position: relative;
            width: 220px;
            height: 220px;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: transform 0.4s ease;
        }

        .arc-outer-ring {
            position: absolute;
            inset: 0;
            border: 2px dashed rgba(0, 240, 255, 0.5);
            border-radius: 50%;
            animation: spin 20s linear infinite;
        }

        .arc-segment-ring {
            position: absolute;
            inset: 12px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-bottom: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin-reverse 10s linear infinite;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
        }

        .arc-inner-housing {
            position: absolute;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 2px solid rgba(0, 240, 255, 0.8);
            background: rgba(0, 240, 255, 0.05);
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
        }

        .arc-coils {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: repeating-conic-gradient(
                from 0deg,
                #00f0ff 0deg 15deg,
                transparent 15deg 36deg
            );
            opacity: 0.85;
            mask-image: radial-gradient(circle, transparent 52%, black 53%, black 70%, transparent 71%);
            -webkit-mask-image: radial-gradient(circle, transparent 52%, black 53%, black 70%, transparent 71%);
            filter: drop-shadow(0 0 8px #00f0ff);
        }

        .arc-core-glow {
            width: 65px;
            height: 65px;
            background: #ffffff;
            border-radius: 50%;
            box-shadow: 
                0 0 20px #00f0ff,
                0 0 40px #00f0ff,
                0 0 60px #00f0ff;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: pulse 2s infinite ease-in-out;
        }

        .arc-center-label {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.65rem;
            font-weight: 900;
            color: #02060e;
            letter-spacing: 1.5px;
        }

        .terminal-area {  
            display: flex;
            flex-direction: column;  
            gap: 8px;  
            height: 110px;  
        }  

        .log-box {  
            flex: 1;
            overflow-y: auto;  
            color: #7df9ff;  
            font-size: 0.85rem;  
            text-shadow: 0 0 5px #00f0ff;  
            background: rgba(0, 0, 0, 0.5);  
            padding: 8px 12px;
            border-radius: 4px;  
            border: 1px solid rgba(0, 240, 255, 0.3);  
            display: flex;
            align-items: center;
        }  

        .controls {  
            display: flex;
            gap: 10px;  
        }  

        input[type="text"], input[type="date"], input[type="time"] {  
            flex: 1;
            background: rgba(0, 240, 255, 0.08);  
            border: 1px solid #00f0ff;  
            color: #00f0ff;  
            padding: 10px 14px;  
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.95rem;  
            outline: none;  
            border-radius: 4px;  
            box-shadow: inset 0 0 10px rgba(0, 240, 255, 0.1);
        }  

        input[type="text"]::placeholder {
            color: rgba(0, 240, 255, 0.5);
        }

        button {  
            background: rgba(0, 240, 255, 0.2);
            border: 1px solid #00f0ff;  
            color: #00f0ff;  
            padding: 10px 18px;  
            cursor: pointer;  
            font-family: 'Orbitron', sans-serif;  
            font-weight: bold;
            font-size: 0.8rem;  
            border-radius: 4px;
            transition: all 0.2s;  
            letter-spacing: 1px;
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
        }  

        button:hover {
            background: rgba(0, 240, 255, 0.4);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.6);
        }

        button:active {  
            background: #00f0ff;
            color: #000;  
        }  

        .ability-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 10px;
        }

        .ability-item {
            background: rgba(0, 240, 255, 0.1);
            border-left: 3px solid #00f0ff;
            padding: 8px;
            border-radius: 3px;
        }

        .ability-title {
            font-weight: bold;
            color: #ffffff;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
        }

        .ability-desc {
            font-size: 0.78rem;
            color: #a2f2ff;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }  
        @keyframes spin-reverse { 100% { transform: rotate(-360deg); } }  
        @keyframes pulse { 0%, 100% { opacity: 0.7; transform: scale(0.98); } 50% { opacity: 1; transform: scale(1.02); } }  
    </style>  
</head>  
<body>  

    <div id="loader">  
        <div class="loader-ring"></div>  
        <div class="loader-text">INITIALIZING STARK HUD v8.0...</div>  
    </div>  

    <div id="hud-container">  
        <header>  
            <div class="system-title">J.A.R.V.I.S. SYSTEM OS</div>  
            <div id="clock">00:00:00</div>  
        </header>  

        <div id="workspace" class="workspace">  
            <div id="left-panel" class="hud-panel" ondragover="allowDrop(event)" ondrop="dropCard(event, 'left-content')">  
                <div class="panel-header">
                    <h3 id="left-title">SYSTEM & DATA NETWORK</h3>  
                    <button class="close-btn" onclick="closePanel('left-panel')">✕</button>
                </div>
                <div id="left-content">  
                    <div class="vital-row"><span>CPU TEMP:</span> <span id="val-temp" class="vital-value">42°C</span></div>
                    <div class="vital-row"><span>CORE LOAD:</span> <span id="val-load" class="vital-value">18%</span></div>
     
                    <div style="margin-top: 15px; border-bottom: 1px solid rgba(0, 240, 255, 0.3); padding-bottom: 4px; font-weight: bold;">NOTES & SCHEMATICS</div>
                    <div class="cal-input-group">
                        <input type="text" id="noteInput" placeholder="Jot down a note...">
                        <button onclick="addNoteFromUI()">SAVE NOTE</button>
                    </div>
                    <div id="notes-list" class="notes-list"></div>

                    <div style="margin-top: 18px; border-bottom: 1px solid rgba(0, 240, 255, 0.3); padding-bottom: 4px; font-weight: bold;">GOOGLE CALENDAR MANAGER</div>
                    <div class="cal-input-group">
                        <input type="text" id="eventTitle" placeholder="Event Description...">
                        <input type="date" id="eventDate">
                        <button onclick="addCalendarEventFromUI()">ADD TO CALENDAR</button>
                    </div>
                    <div id="calendar-list" class="calendar-list"></div>

                    <div style="margin-top: 18px; border-bottom: 1px solid rgba(0, 240, 255, 0.3); padding-bottom: 4px; font-weight: bold;">DATABASE & SOURCES</div>
                    <div class="site-category">1. SPORTS</div>
                    <div class="site-links-grid">
                        <a href="https://www.espn.com" target="_blank" class="site-link"><span>ESPN</span> ↗</a>
                        <a href="https://www.bbc.com/sport" target="_blank" class="site-link"><span>BBC Sport</span> ↗</a>
                    </div>
                    <div class="site-category">2. SCIENCE</div>
                    <div class="site-links-grid">
                        <a href="https://www.nasa.gov" target="_blank" class="site-link"><span>NASA</span> ↗</a>
                        <a href="https://www.livescience.com" target="_blank" class="site-link"><span>Live Science</span> ↗</a>
                    </div>
                </div>  
            </div>  

            <div class="logo-container" id="center-zone" ondragover="allowDrop(event)" ondrop="dropCard(event, 'center-dropped-cards')">  
                <div id="arcReactor" class="arc-reactor">
                    <div class="arc-outer-ring"></div>
                    <div class="arc-segment-ring"></div>
                    <div class="arc-inner-housing">
                        <div class="arc-coils"></div>
                        <div class="arc-core-glow">
                            <span class="arc-center-label">STARK</span>
                        </div>
                    </div>
                </div>
                <div id="center-dropped-cards" style="position: absolute; top: 10px; width: 90%; max-height: 90%; overflow-y: auto; z-index: 30;"></div>
            </div>  

            <div id="right-panel" class="hud-panel" ondragover="allowDrop(event)" ondrop="dropCard(event, 'right-content')">  
                <div class="panel-header">
                    <h3 id="right-title">RESPONSE STACK</h3>  
                    <button class="close-btn" onclick="closePanel('right-panel')">✕</button>
                </div>
                <div id="right-content">  
                    <p style="opacity: 0.7;">Greetings, Sir. Speak or type instructions...</p>
                </div>  
            </div>  
        </div>  

        <div class="terminal-area">  
            <div id="log" class="log-box">SYSTEM: Standby mode active. Listening for commands...</div>  
            <div class="controls">  
                <input type="text" id="userInput" placeholder="Ask anything, say 'Jarvis what are your special abilities', 'bring up Google Calendar in the middle'..." onkeydown="if(event.key==='Enter') processInput()">  
                <button onclick="processInput()">SEND</button>  
                <button id="micBtn" onclick="toggleVoiceListening()">MIC: ON</button>  
            </div>  
        </div>  
    </div>  

    <div id="center-calendar-overlay">
        <div class="overlay-header">
            <div class="overlay-title">GOOGLE CALENDAR // HUD CENTER OVERLAY</div>
            <button class="close-btn" onclick="hideCenterCalendar()" style="font-size:1.2rem;">✕ CLOSE</button>
        </div>
        <iframe class="calendar-frame" src="https://calendar.google.com/calendar/embed?src=en.usa%23holiday%40group.v.calendar.google.com&ctz=America%2FNew_York"></iframe>
    </div>

    <script>  
        let availableVoices = [];
        let familyCalendar = JSON.parse(localStorage.getItem('jarvis_calendar')) || [
            { id: 1, title: "Family Game Night", date: "2026-08-07", time: "19:00" },
            { id: 2, title: "Mom's Birthday", date: "2026-08-15", time: "12:00" }
        ];
        let userNotes = JSON.parse(localStorage.getItem('jarvis_notes')) || [];
        let jarvisMemory = JSON.parse(localStorage.getItem('jarvis_memory')) || {};
        let recognition = null;
        let isListening = false;
        let lastDraggedCardId = null;

        const GREETINGS = [
            "hey jarvis", "hi jarvis", "hello jarvis", "jarvis", "hey", "hello", 
            "good morning", "good evening", "good afternoon", "how are you", "whats up", "what's up"
        ];
        const GREETING_RESPONSES = [
            "Hello Sir, what can I do for you today?",
            "At your service, Sir. What do you need?",
            "Always a pleasure, Sir. How can I help?",
            "Online and fully operational, Sir."
        ];

        window.onload = () => {
            renderCalendar();
            renderNotes();
            initVoiceRecognition();
        };

        setTimeout(() => {  
            const loader = document.getElementById('loader');  
            if (loader) {  
                loader.style.opacity = '0';  
                setTimeout(() => {  
                    loader.style.display = 'none'; 
                    speak("System online. Permanent memory restored. Calendar sync ready.");  
                }, 800);  
            }  
        }, 1500);

        setInterval(() => {  
            const clock = document.getElementById('clock');  
            if (clock) clock.innerText = new Date().toLocaleTimeString();  
            
            const tempVal = document.getElementById('val-temp');
            const loadVal = document.getElementById('val-load');
            if (tempVal) tempVal.innerText = (40 + Math.floor(Math.random() * 5)) + "°C";
            if (loadVal) loadVal.innerText = (15 + Math.floor(Math.random() * 20)) + "%";
        }, 1000);

        function speak(text) {  
            try {  
                if (!('speechSynthesis' in window)) return;
                window.speechSynthesis.cancel();  

                const utterance = new SpeechSynthesisUtterance(text);  
                utterance.pitch = 0.95;  
                utterance.rate = 1.0;    

                const voices = availableVoices.length ? availableVoices : window.speechSynthesis.getVoices();
                const preferredVoice = voices.find(v => 
                    v.name.includes('Google UK English Male') || 
                    v.name.includes('Natural') ||
                    v.name.includes('Oliver') ||
                    v.name.includes('Daniel')
                ) || voices.find(v => v.lang.includes('en-GB')) || voices[0];  

                if (preferredVoice) utterance.voice = preferredVoice;  
                window.speechSynthesis.speak(utterance);
            } catch (e) {}  

            const log = document.getElementById('log');
            if (log) log.innerText = "JARVIS: " + text;  
        }  

        window.speechSynthesis.onvoiceschanged = () => {  
            availableVoices = window.speechSynthesis.getVoices();
        };  

        function closePanel(panelId) { document.getElementById(panelId).style.display = 'none'; }
        function showPanel(panelSide) { document.getElementById(panelSide + '-panel').style.display = 'block'; }

        function showCenterCalendar() {
            const overlay = document.getElementById('center-calendar-overlay');
            if (overlay) overlay.classList.add('active');
            speak("Displaying Google Calendar in the center of your screen, Sir.");
        }

        function hideCenterCalendar() {
            const overlay = document.getElementById('center-calendar-overlay');
            if (overlay) overlay.classList.remove('active');
        }

        function saveStateToDisk() {
            localStorage.setItem('jarvis_calendar', JSON.stringify(familyCalendar));
            localStorage.setItem('jarvis_notes', JSON.stringify(userNotes));
            localStorage.setItem('jarvis_memory', JSON.stringify(jarvisMemory));
        }

        function renderCalendar() {
            const list = document.getElementById('calendar-list');
            if (!list) return;
            list.innerHTML = '';
            familyCalendar.forEach((evt) => {
                const item = document.createElement('div');
                item.className = 'calendar-item';
                item.innerHTML = `<div><div class="event-title">${evt.title}</div><div class="event-date">📅 ${evt.date} ${evt.time ? '🕒 ' + evt.time : ''}</div></div>
                <div>
                    <button class="expand-btn" style="padding:2px 5px;" onclick="syncToGoogleCalendar('${encodeURIComponent(evt.title)}', '${evt.date}')">Sync</button>
                    <button class="expand-btn" style="padding:2px 5px; color:#ff3366;" onclick="deleteCalendarEvent(${evt.id})">✕</button>
                </div>`;
                list.appendChild(item);
            });
            saveStateToDisk();
        }

        function deleteCalendarEvent(id) {
            familyCalendar = familyCalendar.filter(evt => evt.id !== id);
            renderCalendar();
            speak("Removed event from calendar, Sir.");
        }

        function renderNotes() {
            const list = document.getElementById('notes-list');
            if (!list) return;
            list.innerHTML = '';
            userNotes.forEach((note, index) => {
                const item = document.createElement('div');
                item.className = 'note-item';
                item.innerHTML = `<div><div class="note-text">• ${note.text}</div><div class="note-date">🕒 ${note.date}</div></div>
                <button class="expand-btn" style="padding:2px 5px;" onclick="deleteNote(${index})">✕</button>`;
                list.appendChild(item);
            });
            saveStateToDisk();
        }

        function addNoteFromUI() {
            const noteInput = document.getElementById('noteInput');
            if (!noteInput || !noteInput.value.trim()) return;
            userNotes.push({ text: noteInput.value.trim(), date: new Date().toLocaleTimeString() });
            noteInput.value = '';
            renderNotes();
            speak("Note saved, Sir.");
        }

        function deleteNote(index) { userNotes.splice(index, 1); renderNotes(); speak("Note deleted, Sir."); }

        function syncToGoogleCalendar(title, dateStr) {
            const cleanDate = dateStr.replace(/-/g, '');
            const gCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${cleanDate}/${cleanDate}`;
            window.open(gCalUrl, '_blank');
        }

        function addCalendarEventFromUI() {
            const titleInput = document.getElementById('eventTitle');
            const dateInput = document.getElementById('eventDate');
            if (!titleInput.value) return;

            const title = titleInput.value;
            const dateStr = dateInput.value || new Date().toISOString().split('T')[0];
            
            familyCalendar.push({ id: Date.now(), title: title, date: dateStr, time: "12:00" });
            renderCalendar();

            speak(`Adding ${title} to your Google Calendar, Sir.`);
            syncToGoogleCalendar(encodeURIComponent(title), dateStr);

            titleInput.value = ''; dateInput.value = '';
        }

        /* DRAG AND DROP HANDLERS FOR HUD CARDS */
        function allowDrop(ev) { ev.preventDefault(); }
        function dragCard(ev) {
            ev.dataTransfer.setData("text", ev.target.id);
            lastDraggedCardId = ev.target.id;
        }
        function dropCard(ev, targetContainerId) {
            ev.preventDefault();
            const data = ev.dataTransfer.getData("text");
            const draggedElement = document.getElementById(data);
            const container = document.getElementById(targetContainerId);
            if (draggedElement && container) {
                container.appendChild(draggedElement);
                speak("Repositioned card element, Sir.");
            }
        }

        /* CONTINUOUS VOICE & WAKE WORD RECOGNITION */
        function initVoiceRecognition() {
            if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) return;

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = false;
            recognition.lang = 'en-US';

            recognition.onresult = (event) => {
                const lastResultIndex = event.results.length - 1;
                const transcript = event.results[lastResultIndex][0].transcript.trim();
                document.getElementById('userInput').value = transcript;
                processInput();
            };

            recognition.onerror = () => { if (isListening) setTimeout(() => recognition.start(), 1000); };
            recognition.onend = () => { if (isListening) recognition.start(); };

            toggleVoiceListening(true);
        }

        function toggleVoiceListening(forceStart = false) {
            if (!recognition) return;
            const micBtn = document.getElementById('micBtn');

            if (isListening && !forceStart) {
                isListening = false;
                recognition.stop();
                if (micBtn) micBtn.innerText = "MIC: OFF";
            } else {
                isListening = true;
                try { recognition.start(); } catch(e) {}
                if (micBtn) micBtn.innerText = "MIC: LISTENING";
            }
        }

        function displayAbilities() {
            showPanel('right');
            const rightContent = document.getElementById('right-content');
            
            const abilitiesHTML = `
                <div class="response-card" id="abilities-card" draggable="true" ondragstart="dragCard(event)">
                    <div class="card-source">J.A.R.V.I.S. CORE CAPABILITIES</div>
                    <div class="card-title">System Features & Voice Commands</div>
                    <div class="ability-list">
                        <div class="ability-item">
                            <div class="ability-title">1. CENTER GOOGLE CALENDAR</div>
                            <div class="ability-desc">"Bring up Google Calendar in the middle of my screen" opens interactive calendar modal.</div>
                        </div>
                        <div class="ability-item">
                            <div class="ability-title">2. CALENDAR CONTROLS</div>
                            <div class="ability-desc">"Add [event] to my calendar", "Remove [event] from calendar", or "Switch time of [event] to 3 PM".</div>
                        </div>
                        <div class="ability-item">
                            <div class="ability-title">3. INTERACTIVE DRAG & DROP</div>
                            <div class="ability-desc">Drag any result card across left panel, center zone, or right stack.</div>
                        </div>
                        <div class="ability-item">
                            <div class="ability-title">4. LAYOUT MOVEMENT</div>
                            <div class="ability-desc">"Move this to the other side of the screen" shifts active elements across panels.</div>
                        </div>
                        <div class="ability-item">
                            <div class="ability-title">5. PERMANENT MEMORY & NOTES</div>
                            <div class="ability-desc">"Remember [x] is [y]" and quick HUD schematic notes.</div>
                        </div>
                        <div class="ability-item">
                            <div class="ability-title">6. LIVE NEWS & WEB DATA</div>
                            <div class="ability-desc">Ask real-time questions to fetch dynamic web cards and RSS news feeds.</div>
                        </div>
                    </div>
                </div>
            `;
            rightContent.innerHTML = abilitiesHTML;
            speak("I am equipped with center Google Calendar embedding, full event editing, dynamic card drag-and-drop, layout side-swapping, persistent memory, schematic note taking, and live network searching, Sir.");
        }

        async function fetchLiveNewsAndData(query) {
            showPanel('right');
            const rightContent = document.getElementById('right-content');
            rightContent.innerHTML = '<p style="color:#00f0ff;">Searching live data feeds for: ' + query + '...</p>';
            
            try {
                const newsRssUrl = `https://news.google.com/rss/search?q=${encodeURIComponent(query)}&hl=en-US&gl=US&ceid=US:en`;
                const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(newsRssUrl)}`;
                
                const response = await fetch(apiUrl);
                const data = await response.json();

                if (data.status === 'ok' && data.items && data.items.length > 0) {
                    rightContent.innerHTML = '';
                    data.items.slice(0, 4).forEach((item, idx) => {
                        const card = document.createElement('div');
                        const cardId = 'card-' + Date.now() + '-' + idx;
                        card.className = 'response-card';
                        card.id = cardId;
                        card.draggable = true;
                        card.ondragstart = dragCard;

                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = item.description || item.content;
                        const cleanText = tempDiv.innerText.slice(0, 220) + '...';

                        card.innerHTML = `
                            <div class="card-source">${item.author || data.feed.title || 'LIVE DATA FEED'}</div>
                            <div class="card-title">${item.title}</div>
                            <div class="card-snippet">${cleanText}</div>
                            <div class="card-actions">
                                <button class="expand-btn" onclick="document.getElementById('${cardId}').classList.toggle('enlarged')">ENLARGE</button>
                                <a href="${item.link}" target="_blank" class="link-btn">READ MORE ↗</a>
                            </div>
                        `;
                        rightContent.appendChild(card);
                        lastDraggedCardId = cardId;
                    });

                    speak(`Pulled live data for ${query}, Sir.`);
                    return;
                }
            } catch (err) {}

            rightContent.innerHTML = `
                <div class="response-card" id="card-search-fallback" draggable="true" ondragstart="dragCard(event)">
                    <div class="card-source">SEARCH RESULTS</div>
                    <div class="card-title">Query: ${query}</div>
                    <div class="card-snippet">Launch complete web inquiry via Google:</div>
                    <div class="card-actions">
                        <a href="https://www.google.com/search?q=${encodeURIComponent(query)}" target="_blank" class="link-btn">SEARCH GOOGLE ↗</a>
                    </div>
                </div>
            `;
            speak(`Generated live web query for ${query}, Sir.`);
        }

        async function processInput() {  
            const inputField = document.getElementById('userInput');
            if (!inputField) return;  
            const query = inputField.value.trim();  
            if (!query) return;  

            inputField.value = '';  
            const qLower = query.toLowerCase().replace(/['’]/g, '');

            // ------------------------------------------
            // 1. CONVERSATIONAL & GREETING CHECK (PREVENTS LIVE NEWS SEARCH FOR "HEY JARVIS")
            // ------------------------------------------
            const cleanGreetingQuery = qLower.replace(/[^a-z0-9\s]/gi, '').trim();
            if (GREETINGS.includes(cleanGreetingQuery)) {
                const randomGreeting = GREETING_RESPONSES[Math.floor(Math.random() * GREETING_RESPONSES.length)];
                speak(randomGreeting);
                return;
            }

            // ------------------------------------------
            // 2. SPECIAL ABILITIES COMMAND
            // ------------------------------------------
            if (qLower.includes('special abilities') || qLower.includes('what can you do') || qLower.includes('your abilities') || qLower.includes('what are your capabilities')) {
                displayAbilities();
                return;
            }

            // ------------------------------------------
            // 3. CENTER GOOGLE CALENDAR COMMANDS
            // ------------------------------------------
            if (qLower.includes('google calendar') && (qLower.includes('middle') || qLower.includes('center') || qLower.includes('pop up') || qLower.includes('bring up') || qLower.includes('show'))) {
                showCenterCalendar();
                return;
            }

            if (qLower.includes('close calendar') || qLower.includes('hide calendar')) {
                hideCenterCalendar();
                speak("Closing Google Calendar center overlay, Sir.");
                return;
            }

            // CALENDAR EDIT INTENTS (ADD, REMOVE, SWITCH TIME)
            if (qLower.includes('remove') && qLower.includes('calendar')) {
                let eventNameToRemove = query.replace(/remove/i, '').replace(/from (my |the )?calendar/i, '').replace(/jarvis/i, '').trim();
                const match = familyCalendar.find(e => e.title.toLowerCase().includes(eventNameToRemove.toLowerCase()));
                if (match) {
                    deleteCalendarEvent(match.id);
                } else {
                    speak(`Could not find an event matching ${eventNameToRemove} to remove.`);
                }
                return;
            }

            if ((qLower.includes('switch time') || qLower.includes('change time') || qLower.includes('move time')) && qLower.includes('calendar')) {
                let eventName = query.replace(/switch the time of|change time of|move time of|switch time/i, '').replace(/to .*/i, '').replace(/jarvis/i, '').trim();
                let timeMatch = query.match(/(\d{1,2}:\d{2}\s*(?:am|pm)?)/i);
                let newTime = timeMatch ? timeMatch[0] : "15:00";

                const match = familyCalendar.find(e => e.title.toLowerCase().includes(eventName.toLowerCase()));
                if (match) {
                    match.time = newTime;
                    renderCalendar();
                    speak(`Switched time of ${match.title} to ${newTime}, Sir.`);
                } else {
                    speak(`Could not locate ${eventName} on your calendar, Sir.`);
                }
                return;
            }

            if (qLower.includes('add') && qLower.includes('calendar')) {
                let cleanTitle = query.replace(/add/i, '').replace(/to (my |the )?(google )?calendar/i, '').replace(/schedule/i, '').trim();
                const today = new Date().toISOString().split('T')[0];
                const eventName = cleanTitle || "New Event";
                
                familyCalendar.push({ id: Date.now(), title: eventName, date: today, time: "12:00" });
                renderCalendar();
                showPanel('left');

                speak(`Added ${eventName} to your calendar, Sir.`);
                syncToGoogleCalendar(encodeURIComponent(eventName), today);
                return;
            }

            // ------------------------------------------
            // 4. MOVE THIS TO THE OTHER SIDE COMMAND
            // ------------------------------------------
            if (qLower.includes('move this to the other side') || qLower.includes('move card') || qLower.includes('swap sides')) {
                if (lastDraggedCardId && document.getElementById(lastDraggedCardId)) {
                    const cardElem = document.getElementById(lastDraggedCardId);
                    const leftContent = document.getElementById('left-content');
                    const rightContent = document.getElementById('right-content');

                    if (cardElem.parentElement.id === 'right-content') {
                        leftContent.appendChild(cardElem);
                        showPanel('left');
                        speak("Moved active card to the left panel, Sir.");
                    } else {
                        rightContent.appendChild(cardElem);
                        showPanel('right');
                        speak("Moved active card to the right panel, Sir.");
                    }
                } else {
                    const workspace = document.getElementById('workspace');
                    if (workspace.style.gridTemplateColumns === '380px 1fr 340px') {
                        workspace.style.gridTemplateColumns = '340px 1fr 380px';
                    } else {
                        workspace.style.gridTemplateColumns = '380px 1fr 340px';
                    }
                    speak("Swapped UI workspace sides, Sir.");
                }
                return;
            }

            // ------------------------------------------
            // 5. PERMANENT MEMORY & SYSTEM COMMANDS
            // ------------------------------------------
            if (qLower.startsWith('remember ') || qLower.startsWith('save ')) {
                const parts = query.replace(/remember|save/i, '').trim().split(/ as | is /i);
                if (parts.length >= 2) {
                    const key = parts[0].trim().toLowerCase();
                    const value = parts[1].trim();
                    jarvisMemory[key] = value;
                    saveStateToDisk();
                    speak(`Saved to permanent memory. ${key} is set to ${value}.`);
                    return;
                }
            }

            if (qLower.includes('clear screen') || qLower.includes('wipe screen') || qLower.includes('clear everything')) {
                document.getElementById('right-content').innerHTML = '<p style="opacity: 0.7;">Screen cleared. Standing by for instructions, Sir.</p>';
                speak("All screen elements have been cleared, Sir.");
                return;
            }

            // DEFAULT LIVE DATA FETCH FOR REAL QUESTIONS
            await fetchLiveNewsAndData(query);
        }
    </script>  
