<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>J.A.R.V.I.S. Core Interface v5.0</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Share+Tech+Mono&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            height: 100%;
            background-color: #030a16;
            color: #00f0ff;
            font-family: 'Share Tech Mono', monospace;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            touch-action: none;
            -webkit-user-select: none;
            user-select: none;
        }

        body::before {
            content: " ";
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 10;
            background-size: 100% 3px, 6px 100%;
            pointer-events: none;
        }

        #loader {
            position: fixed;
            inset: 0;
            background-color: #02060e;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 999;
            transition: opacity 0.5s ease;
        }

        .loader-ring {
            width: 80px;
            height: 80px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            box-shadow: 0 0 15px #00f0ff;
        }

        .loader-text {
            margin-top: 15px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.85rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
        }

        #hud-container {
            flex: 1;
            width: 100vw;
            height: 100vh;
            border: 1px solid rgba(0, 240, 255, 0.3);
            background: rgba(4, 18, 38, 0.6);
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            padding: 10px;
            gap: 10px;
            position: relative;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            padding-bottom: 5px;
            height: 35px;
            z-index: 20;
        }

        .system-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            text-shadow: 0 0 10px #00f0ff;
        }

        .workspace {
            flex: 1;
            position: relative;
            overflow: hidden;
            width: 100%;
            height: 100%;
        }

        .hud-panel {
            position: absolute;
            width: 280px;
            max-width: 80vw;
            background: rgba(0, 240, 255, 0.12);
            border: 1px solid #00f0ff;
            padding: 10px;
            border-radius: 6px;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.25);
            font-size: 0.8rem;
            line-height: 1.3;
            backdrop-filter: blur(8px);
            z-index: 30;
            touch-action: none;
        }

        .drag-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0, 240, 255, 0.3);
            color: #ffffff;
            padding: 6px 8px;
            margin: -10px -10px 8px -10px;
            border-bottom: 1px solid #00f0ff;
            border-radius: 5px 5px 0 0;
            cursor: move;
            touch-action: none;
        }

        .drag-handle {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 1px;
            flex-grow: 1;
        }

        .close-btn {
            background: rgba(255, 0, 85, 0.6);
            border: 1px solid #ff0055;
            color: #fff;
            border-radius: 3px;
            padding: 1px 6px;
            font-size: 0.7rem;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
        }

        .hud-panel h3 {
            font-family: 'Orbitron', sans-serif;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            margin-bottom: 6px;
            padding-bottom: 4px;
            font-size: 0.85rem;
            color: #ffffff;
            text-shadow: 0 0 8px #00f0ff;
            text-transform: uppercase;
        }

        .news-item {
            background: rgba(0, 240, 255, 0.08);
            border-left: 2px solid #00f0ff;
            padding: 6px;
            margin-bottom: 6px;
        }

        .news-item strong {
            color: #fff;
            display: block;
            font-size: 0.8rem;
        }

        .news-item p {
            color: #b0efff;
            font-size: 0.72rem;
        }

        .arc-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            z-index: 15;
        }

        .arc-reactor {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 2px dashed #00f0ff;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: spin 20s linear infinite;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
        }

        .arc-core {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: radial-gradient(circle, #ffffff 0%, #00f0ff 60%, rgba(0,240,255,0) 100%);
            box-shadow: 0 0 25px #00f0ff;
            animation: pulse 2s ease-in-out infinite;
        }

        .terminal-area {
            display: flex;
            flex-direction: column;
            gap: 6px;
            height: 90px;
            z-index: 20;
        }

        .log-box {
            flex: 1;
            overflow-y: auto;
            color: #7df9ff;
            font-size: 0.8rem;
            text-shadow: 0 0 5px #00f0ff;
            background: rgba(0, 0, 0, 0.5);
            padding: 6px;
            border-radius: 4px;
            border: 1px solid rgba(0, 240, 255, 0.2);
        }

        .controls {
            display: flex;
            gap: 6px;
        }

        input[type="text"] {
            flex: 1;
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 8px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.85rem;
            outline: none;
            border-radius: 4px;
            -webkit-user-select: text;
            user-select: text;
        }

        button {
            background: rgba(0, 240, 255, 0.25);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 8px 12px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            border-radius: 4px;
        }

        button:active {
            background: #00f0ff;
            color: #000;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
        @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
    </style>
</head>
<body>

    <div id="loader">
        <div class="loader-ring"></div>
        <div class="loader-text">INITIALIZING STARK HUD v5.0...</div>
    </div>

    <div id="hud-container">
        <header>
            <div class="system-title">J.A.R.V.I.S.</div>
            <div id="clock">00:00:00</div>
        </header>

        <div id="workspace" class="workspace">
            <div class="arc-container">
                <div class="arc-reactor">
                    <div class="arc-core"></div>
                </div>
            </div>
        </div>

        <div class="terminal-area">
            <div id="log" class="log-box">SYSTEM: Online and awaiting directives...</div>
            <div class="controls">
                <input type="text" id="userInput" placeholder="Type or tap MIC (e.g. 'nfl news', 'einstein')..." onkeydown="if(event.key==='Enter') processInput()">
                <button onclick="processInput()">SEND</button>
                <button onclick="startVoice()">MIC</button>
            </div>
        </div>
    </div>

    <script>
        let topZIndex = 100;

        // --- Drag Engine for Touch and Mouse ---
        function makeDraggable(element) {
            const handle = element.querySelector('.drag-header') || element;
            let startX = 0, startY = 0, currentLeft = 0, currentTop = 0;

            function onStart(e) {
                if (e.target.classList.contains('close-btn')) return;

                topZIndex++;
                element.style.zIndex = topZIndex;

                const touch = e.touches ? e.touches[0] : e;
                startX = touch.clientX;
                startY = touch.clientY;

                currentLeft = element.offsetLeft;
                currentTop = element.offsetTop;

                window.addEventListener('mousemove', onMove);
                window.addEventListener('mouseup', onEnd);
                window.addEventListener('touchmove', onMove, { passive: false });
                window.addEventListener('touchend', onEnd);
            }

            function onMove(e) {
                if (e.cancelable) e.preventDefault();
                const touch = e.touches ? e.touches[0] : e;

                const deltaX = touch.clientX - startX;
                const deltaY = touch.clientY - startY;

                element.style.left = (currentLeft + deltaX) + 'px';
                element.style.top = (currentTop + deltaY) + 'px';
                element.style.right = 'auto';
            }

            function onEnd() {
                window.removeEventListener('mousemove', onMove);
                window.removeEventListener('mouseup', onEnd);
                window.removeEventListener('touchmove', onMove);
                window.removeEventListener('touchend', onEnd);
            }

            handle.addEventListener('mousedown', onStart);
            handle.addEventListener('touchstart', onStart, { passive: false });
        }

        // --- Clock & Loader ---
        setTimeout(() => {
            const loader = document.getElementById('loader');
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(() => loader.style.display = 'none', 500);
            }
            speak("System online, Sir.");
        }, 1200);

        setInterval(() => {
            const clock = document.getElementById('clock');
            if (clock) clock.innerText = new Date().toLocaleTimeString();
        }, 1000);

        function speak(text) {
            const log = document.getElementById('log');
            if (log) log.innerText = "JARVIS: " + text;

            try {
                if (!('speechSynthesis' in window)) return;
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.pitch = 0.95;
                utterance.rate = 1.0;
                window.speechSynthesis.speak(utterance);
            } catch (e) {}
        }

        // --- Panel Creation & Layout ---
        function createPanel(titleHTML, side = 'right') {
            const workspace = document.getElementById('workspace');
            const panel = document.createElement('div');
            panel.className = 'hud-panel';
            topZIndex++;
            panel.style.zIndex = topZIndex;

            panel.innerHTML = `
                <div class="drag-header">
                    <span class="drag-handle">::: DRAG :::</span>
                    <button class="close-btn" onclick="this.closest('.hud-panel').remove()">X</button>
                </div>
                ${titleHTML}
            `;

            workspace.appendChild(panel);
            makeDraggable(panel);

            // Side positioning
            const workspaceWidth = workspace.clientWidth;
            if (side === 'left') {
                panel.style.left = '10px';
            } else {
                panel.style.left = Math.max(10, workspaceWidth - 290) + 'px';
            }
            panel.style.top = '20px';

            return panel;
        }

        // --- Command Processor ---
        async function processInput() {
            const inputField = document.getElementById('userInput');
            if (!inputField) return;
            const rawText = inputField.value.trim();
            if (!rawText) return;

            inputField.value = '';
            const textLower = rawText.toLowerCase();

            if (textLower.includes('clear') || textLower.includes('close')) {
                document.querySelectorAll('.hud-panel').forEach(p => p.remove());
                speak("Cleared HUD panels.");
                return;
            }

            let side = textLower.includes('left') ? 'left' : 'right';

            // Clean query text
            let query = rawText.replace(/on the left|on left|on the right|on right|show me|give me|latest news on|news|search/gi, '').trim();
            if (!query) query = "NFL";

            speak("Accessing telemetry for " + query + ".");
            await fetchTelemetryData(query, side);
        }

        // --- API Data Fetching ---
        async function fetchTelemetryData(query, side) {
            const panel = createPanel(`<h3>SEARCHING: ${query.toUpperCase()}</h3><p>Connecting to feeds...</p>`, side);
            const qLower = query.toLowerCase();

            // 1. ESPN NFL Integration
            if (qLower.includes('nfl') || qLower.includes('football') || qLower.includes('sports')) {
                try {
                    const res = await fetch('https://site.api.espn.com/apis/site/v2/sports/football/nfl/news');
                    if (res.ok) {
                        const data = await res.json();
                        if (data.articles && data.articles.length > 0) {
                            let content = `<h3>NFL NEWS FEED</h3>`;
                            data.articles.slice(0, 3).forEach(item => {
                                content += `
                                    <div class="news-item">
                                        <strong>${item.headline}</strong>
                                        <p>${item.description || 'Live ESPN headline.'}</p>
                                    </div>
                                `;
                            });
                            panel.innerHTML = `
                                <div class="drag-header">
                                    <span class="drag-handle">::: DRAG :::</span>
                                    <button class="close-btn" onclick="this.closest('.hud-panel').remove()">X</button>
                                </div>
                                ${content}
                            `;
                            speak("NFL news telemetry updated.");
                            return;
                        }
                    }
                } catch (e) {}
            }

            // 2. Wikipedia Integration
            try {
                const searchRes = await fetch('https://en.wikipedia.org/w/api.php?action=opensearch&search=' + encodeURIComponent(query) + '&limit=1&namespace=0&format=json&origin=*');
                if (searchRes.ok) {
                    const searchData = await searchRes.json();
                    if (searchData && searchData[1] && searchData[1].length > 0) {
                        const pageTitle = searchData[1][0];
                        const summaryRes = await fetch('https://en.wikipedia.org/api/rest_v1/page/summary/' + encodeURIComponent(pageTitle));
                        if (summaryRes.ok) {
                            const wikiData = await summaryRes.json();
                            if (wikiData.extract) {
                                panel.innerHTML = `
                                    <div class="drag-header">
                                        <span class="drag-handle">::: DRAG :::</span>
                                        <button class="close-btn" onclick="this.closest('.hud-panel').remove()">X</button>
                                    </div>
                                    <h3>${wikiData.title.toUpperCase()}</h3>
                                    <p>${wikiData.extract}</p>
                                `;
                                speak(wikiData.extract.substring(0, 100) + '...');
                                return;
                            }
                        }
                    }
                }
            } catch (e) {}

            // Fallback Panel
            panel.innerHTML = `
                <div class="drag-header">
                    <span class="drag-handle">::: DRAG :::</span>
                    <button class="close-btn" onclick="this.closest('.hud-panel').remove()">X</button>
                </div>
                <h3>TELEMETRY: ${query.toUpperCase()}</h3>
                <p>• Data stream initialized.</p>
                <p>• Ready for query: ${query}</p>
            `;
            speak("Telemetry readout generated.");
        }

        // --- Voice Mic Handler ---
        function startVoice() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Speech recognition is not supported on this browser.");
                return;
            }

            const recognition = new SpeechRecognition();
            recognition.lang = 'en-US';
            recognition.start();

            const log = document.getElementById('log');
            if (log) log.innerText = "SYSTEM: Listening...";

            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                document.getElementById('userInput').value = transcript;
                processInput();
            };

            recognition.onerror = () => {
                speak("Voice recognition error.");
            };
        }
    </script>
</body>
</html>
