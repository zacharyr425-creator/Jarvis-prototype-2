            speak("My capabilities include taking notes for later, helping you design and build project blueprints, managing your calendar, saving favorite websites, and running live search operations.");
        }

        /* BUILD ASSISTANT GENERATOR */
        function generateBuildSchematic(itemToBuild) {
            showPanel('right');
            const rightContent = document.getElementById('right-content');
            rightContent.innerHTML = `
                <div class="response-card enlarged">
                    <div class="card-source">STARK ENGINEERING WORKSHOP</div>
