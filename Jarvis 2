<!DOCTYPE html>  
<html lang="en">  
<head>  
    <meta charset="UTF-8">  
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">  
    <title>J.A.R.V.I.S. Core Interface v6.0</title>  
    <style>  
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap');
        * {  
            box-sizing: border-box;  
            margin: 0;
            padding: 0;  
            user-select: none;  
        }  

        html, body {  
            width: 100%;
            height: 100%;  
            background-color: #02060e;  
            color: #00f0ff;  
            font-family: 'Share Tech Mono', monospace;  
            overflow: hidden;  
            display: flex;  
            flex-direction: column;
            transition: transform 0.4s ease;
        }  

        /* CRT Overlay Filter */
        body::before {  
            content: " ";
            position: absolute;  
            inset: 0;  
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            z-index: 10;  
            background-size: 100% 3px, 6px 100%;  
            pointer-events: none;  
        }  

        #loader {  
            position: fixed;
            inset: 0;  
            background-color: #02060e;  
            display: flex;  
            flex-direction: column;  
            justify-content: center;  
            align-items: center;  
            z-index: 999;  
            transition: opacity 0.8s ease;
        }  

        .loader-ring {  
            width: 100px;
            height: 100px;  
            border: 3px solid transparent;  
            border-top: 3px solid #00f0ff;  
            border-bottom: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;  
            box-shadow: 0 0 20px #00f0ff;
        }  

        .loader-text {  
            margin-top: 25px;
            font-family: 'Orbitron', sans-serif;  
            font-size: 0.9rem;  
            letter-spacing: 3px;  
            color: #00f0ff;
            text-shadow: 0 0 10px #00f0ff;  
            animation: pulse 1.5s infinite;
        }  

        #hud-container {  
            flex: 1;
            width: 100vw;  
            height: 100vh;  
            border: 1px solid rgba(0, 240, 255, 0.3);  
            box-shadow: inset 0 0 30px rgba(0, 240, 255, 0.1);
            background: radial-gradient(circle at center, rgba(4, 20, 45, 0.8) 0%, rgba(2, 6, 14, 0.95) 100%);  
            display: flex;  
            flex-direction: column;  
            padding: 15px;
            gap: 12px;  
            position: relative;
        }  

        header {  
            display: flex;
            justify-content: space-between;  
            align-items: center;  
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);  
            padding-bottom: 8px;  
            height: 40px;
        }  

        .system-title {  
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            font-size: 1.2rem;  
            letter-spacing: 3px;  
            text-shadow: 0 0 12px #00f0ff;
        }  

        #clock {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
        }

        .workspace {  
            flex: 1;
            display: grid;  
            grid-template-columns: 340px 1fr 380px;  
            gap: 15px;  
            position: relative;  
            align-items: center;  
            overflow: hidden;  
            transition: all 0.5s ease;
        }  

        .hud-panel {  
            background: rgba(0, 240, 255, 0.04);
            border: 1px solid rgba(0, 240, 255, 0.6);  
            padding: 15px;  
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.1), inset 0 0 15px rgba(0, 240, 255, 0.05);  
            height: 100%;  
            overflow-y: auto;
            display: block;  
            font-size: 0.85rem;  
            line-height: 1.5;  
            position: relative;
            z-index: 5;
            transition: all 0.4s ease;
        }  

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);  
            margin-bottom: 12px;  
            padding-bottom: 6px;
        }

        .hud-panel h3 {  
            font-family: 'Orbitron', sans-serif;
            font-size: 0.95rem;  
            color: #ffffff;  
            text-shadow: 0 0 8px #00f0ff;  
            text-transform: uppercase;  
            letter-spacing: 1px;
            margin: 0;
        }  

        .close-btn {
            background: transparent;
            border: none;
            color: #00f0ff;
            font-family: 'Orbitron', sans-serif;
            font-weight: bold;
            font-size: 0.9rem;
            cursor: pointer;
            padding: 2px 6px;
            box-shadow: none;
        }

        .close-btn:hover {
            color: #ff3366;
            text-shadow: 0 0 8px #ff3366;
            background: transparent;
            box-shadow: none;
        }

        /* RESPONSE CARD STYLING */
        .response-card {
            background: rgba(0, 240, 255, 0.08);
            border: 1px solid rgba(0, 240, 255, 0.4);
            padding: 12px;
            margin-bottom: 12px;
            border-radius: 6px;
            transition: background 0.2s, box-shadow 0.2s, transform 0.3s ease, width 0.3s ease;
            position: relative;
            z-index: 20;
        }

        .response-card:hover {
            background: rgba(0, 240, 255, 0.18);
            border-color: #00f0ff;
            box-shadow: 0 0 12px rgba(0, 240, 255, 0.4);
        }

        .response-card .card-source {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            color: #ff007f;
            text-shadow: 0 0 5px #ff007f;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .response-card .card-title {
            font-weight: bold;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .response-card .card-snippet {
            font-size: 0.8rem;
            color: #a2f2ff;
        }

        .card-actions {
            margin-top: 10px;
            display: flex;
            justify-content: flex-end;
            gap: 6px;
        }

        .expand-btn, .link-btn {
            background: rgba(0, 240, 255, 0.2);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            font-size: 0.7rem;
            padding: 4px 8px;
            cursor: pointer;
            border-radius: 3px;
            font-family: 'Orbitron', sans-serif;
            text-decoration: none;
            display: inline-block;
        }

        .expand-btn:hover, .link-btn:hover {
            background: #00f0ff;
            color: #000;
        }

        .response-card.enlarged {
            width: 100% !important;
            transform: scale(1.02);
            background: rgba(2, 10, 25, 0.95);
            border: 2px solid #00f0ff;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.6);
            padding: 18px;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .response-card.enlarged .card-snippet {
            color: #ffffff;
            font-size: 0.9rem;
        }

        /* VITALS, CALENDAR, NOTES */
        .vital-row {
            display: flex;
            justify-content: space-between;
            margin: 6px 0;
            padding: 6px;
            background: rgba(0, 240, 255, 0.05);
            border-left: 2px solid #00f0ff;
        }

        .vital-value {
            color: #ffffff;
            font-weight: bold;
        }

        .calendar-list, .notes-list {
            margin-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .calendar-item, .note-item {
            background: rgba(0, 240, 255, 0.08);
            border: 1px solid rgba(0, 240, 255, 0.3);
            padding: 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .calendar-item .event-title, .note-item .note-text {
            color: #fff;
            font-weight: bold;
        }

        .calendar-item .event-date, .note-item .note-date {
            color: #ff007f;
            font-size: 0.75rem;
        }

        .cal-input-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: 10px;
        }

        .cal-input-group input {
            padding: 6px;
            font-size: 0.8rem;
        }

        /* WEBSITES LINK PANEL STYLING */
        .site-category {
            margin-top: 12px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            color: #ff007f;
            text-shadow: 0 0 5px #ff007f;
            letter-spacing: 1px;
        }

        .site-links-grid {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-top: 4px;
        }

        .site-link {
            color: #a2f2ff;
            text-decoration: none;
            background: rgba(0, 240, 255, 0.06);
            border: 1px solid rgba(0, 240, 255, 0.2);
            padding: 4px 8px;
            border-radius: 3px;
            font-size: 0.78rem;
            transition: all 0.2s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .site-link:hover {
            background: rgba(0, 240, 255, 0.25);
            color: #ffffff;
            border-color: #00f0ff;
            box-shadow: 0 0 8px rgba(0, 240, 255, 0.4);
        }

        /* ARC REACTOR LOGO DESIGN */  
        .logo-container {  
            display: flex;
            justify-content: center;  
            align-items: center;  
            grid-column: 2;  
            position: relative;  
            height: 100%;
        }  

        .arc-reactor {
            position: relative;
            width: 220px;
            height: 220px;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: transform 0.4s ease;
        }

        .arc-outer-ring {
            position: absolute;
            inset: 0;
            border: 2px dashed rgba(0, 240, 255, 0.5);
            border-radius: 50%;
            animation: spin 20s linear infinite;
        }

        .arc-segment-ring {
            position: absolute;
            inset: 12px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-bottom: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin-reverse 10s linear infinite;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
        }

        .arc-inner-housing {
            position: absolute;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 2px solid rgba(0, 240, 255, 0.8);
            background: rgba(0, 240, 255, 0.05);
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
        }

        .arc-coils {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: repeating-conic-gradient(
                from 0deg,
                #00f0ff 0deg 15deg,
                transparent 15deg 36deg
            );
            opacity: 0.85;
            mask-image: radial-gradient(circle, transparent 52%, black 53%, black 70%, transparent 71%);
            -webkit-mask-image: radial-gradient(circle, transparent 52%, black 53%, black 70%, transparent 71%);
            filter: drop-shadow(0 0 8px #00f0ff);
        }

        .arc-core-glow {
            width: 65px;
            height: 65px;
            background: #ffffff;
            border-radius: 50%;
            box-shadow: 
                0 0 20px #00f0ff,
                0 0 40px #00f0ff,
                0 0 60px #00f0ff;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: pulse 2s infinite ease-in-out;
        }

        .arc-center-label {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.65rem;
            font-weight: 900;
            color: #02060e;
            letter-spacing: 1.5px;
        }

        .terminal-area {  
            display: flex;
            flex-direction: column;  
            gap: 8px;  
            height: 110px;  
        }  

        .log-box {  
            flex: 1;
            overflow-y: auto;  
            color: #7df9ff;  
            font-size: 0.85rem;  
            text-shadow: 0 0 5px #00f0ff;  
            background: rgba(0, 0, 0, 0.5);  
            padding: 8px 12px;
            border-radius: 4px;  
            border: 1px solid rgba(0, 240, 255, 0.3);  
            display: flex;
            align-items: center;
        }  

        .controls {  
            display: flex;
            gap: 10px;  
        }  

        input[type="text"], input[type="date"] {  
            flex: 1;
            background: rgba(0, 240, 255, 0.08);  
            border: 1px solid #00f0ff;  
            color: #00f0ff;  
            padding: 10px 14px;  
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.95rem;  
            outline: none;  
            border-radius: 4px;  
            box-shadow: inset 0 0 10px rgba(0, 240, 255, 0.1);
        }  

        input[type="text"]::placeholder {
            color: rgba(0, 240, 255, 0.5);
        }

        button {  
            background: rgba(0, 240, 255, 0.2);
            border: 1px solid #00f0ff;  
            color: #00f0ff;  
            padding: 10px 18px;  
            cursor: pointer;  
            font-family: 'Orbitron', sans-serif;  
            font-weight: bold;
            font-size: 0.8rem;  
            border-radius: 4px;
            transition: all 0.2s;  
            letter-spacing: 1px;
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
        }  

        button:hover {
            background: rgba(0, 240, 255, 0.4);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.6);
        }

        button:active {  
            background: #00f0ff;
            color: #000;  
        }  

        @keyframes spin { 100% { transform: rotate(360deg); } }  
        @keyframes spin-reverse { 100% { transform: rotate(-360deg); } }  
        @keyframes pulse { 0%, 100% { opacity: 0.7; transform: scale(0.98); } 50% { opacity: 1; transform: scale(1.02); } }  
    </style>  
</head>  
<body>  

    <div id="loader">  
        <div class="loader-ring"></div>  
        <div class="loader-text">INITIALIZING STARK HUD v6.0...</div>  
    </div>  

    <div id="hud-container">  
        <header>  
            <div class="system-title">J.A.R.V.I.S.</div>  
            <div id="clock">00:00:00</div>  
        </header>  

        <div id="workspace" class="workspace">  
            <div id="left-panel" class="hud-panel">  
                <div class="panel-header">
                    <h3 id="left-title">SYSTEM & DATA NETWORK</h3>  
                    <button class="close-btn" onclick="closePanel('left-panel')">✕</button>
                </div>
                <div id="left-content">  
                    <div class="vital-row"><span>CPU TEMP:</span> <span id="val-temp" class="vital-value">42°C</span></div>
                    <div class="vital-row"><span>CORE LOAD:</span> <span id="val-load" class="vital-value">18%</span></div>
     
                    <div style="margin-top: 15px; border-bottom: 1px solid rgba(0, 240, 255, 0.3); padding-bottom: 4px; font-weight: bold;">NOTES & SCHEMATICS</div>
                    <div class="cal-input-group">
                        <input type="text" id="noteInput" placeholder="Jot down a note...">
                        <button onclick="addNoteFromUI()">SAVE NOTE</button>
                    </div>
                    <div id="notes-list" class="notes-list">
                    </div>

                    <div style="margin-top: 18px; border-bottom: 1px solid rgba(0, 240, 255, 0.3); padding-bottom: 4px; font-weight: bold;">GOOGLE CALENDAR SYNC</div>
                    <div class="cal-input-group">
                        <input type="text" id="eventTitle" placeholder="Event Description...">
                        <input type="date" id="eventDate">
                        <button onclick="addCalendarEventFromUI()">ADD EVENT</button>
                    </div>
                    <div id="calendar-list" class="calendar-list">
                    </div>

                    <div style="margin-top: 18px; border-bottom: 1px solid rgba(0, 240, 255, 0.3); padding-bottom: 4px; font-weight: bold;">SAVED FAVORITE WEBSITES</div>
                    <div id="favorite-websites-grid" class="site-links-grid" style="margin-top:6px;">
                    </div>

                    <div style="margin-top: 18px; border-bottom: 1px solid rgba(0, 240, 255, 0.3); padding-bottom: 4px; font-weight: bold;">DATABASE & SOURCES</div>
                    
                    <div class="site-category">1. SPORTS</div>
                    <div class="site-links-grid">
                        <a href="https://www.espn.com" target="_blank" class="site-link"><span>ESPN</span> ↗</a>
                        <a href="https://www.bbc.com/sport" target="_blank" class="site-link"><span>BBC Sport</span> ↗</a>
                        <a href="https://theathletic.com" target="_blank" class="site-link"><span>The Athletic</span> ↗</a>
                    </div>

                    <div class="site-category">2. SCIENCE</div>
                    <div class="site-links-grid">
                        <a href="https://www.sciencenews.org" target="_blank" class="site-link"><span>ScienceNews</span> ↗</a>
                        <a href="https://www.nasa.gov" target="_blank" class="site-link"><span>NASA</span> ↗</a>
                        <a href="https://www.livescience.com" target="_blank" class="site-link"><span>Live Science</span> ↗</a>
                    </div>

                    <div class="site-category">3. POLITICS</div>
                    <div class="site-links-grid">
                        <a href="https://www.reuters.com" target="_blank" class="site-link"><span>Reuters</span> ↗</a>
                        <a href="https://apnews.com" target="_blank" class="site-link"><span>AP News</span> ↗</a>
                        <a href="https://www.pewresearch.org" target="_blank" class="site-link"><span>Pew Research</span> ↗</a>
                    </div>

                    <div class="site-category">4. HISTORY</div>
                    <div class="site-links-grid">
                        <a href="https://www.worldhistory.org" target="_blank" class="site-link"><span>World History</span> ↗</a>
                        <a href="https://www.history.com" target="_blank" class="site-link"><span>History.com</span> ↗</a>
                        <a href="https://www.archives.gov" target="_blank" class="site-link"><span>National Archives</span> ↗</a>
                    </div>

                    <div class="site-category">5. GRAMMAR</div>
                    <div class="site-links-grid">
                        <a href="https://owl.purdue.edu" target="_blank" class="site-link"><span>Purdue OWL</span> ↗</a>
                        <a href="https://www.grammarly.com/blog" target="_blank" class="site-link"><span>Grammarly Blog</span> ↗</a>
                        <a href="https://www.merriam-webster.com" target="_blank" class="site-link"><span>Merriam-Webster</span> ↗</a>
                    </div>

                    <div class="site-category">6. GENERAL KNOWLEDGE</div>
                    <div class="site-links-grid">
                        <a href="https://www.britannica.com" target="_blank" class="site-link"><span>Britannica</span> ↗</a>
                        <a href="https://www.snopes.com" target="_blank" class="site-link"><span>Snopes</span> ↗</a>
                        <a href="https://www.wolframalpha.com" target="_blank" class="site-link"><span>WolframAlpha</span> ↗</a>
                    </div>
                </div>  
            </div>  

            <div class="logo-container">  
                <div id="arcReactor" class="arc-reactor">
                    <div class="arc-outer-ring"></div>
                    <div class="arc-segment-ring"></div>
                    <div class="arc-inner-housing">
                        <div class="arc-coils"></div>
                        <div class="arc-core-glow">
                            <span class="arc-center-label">STARK</span>
                        </div>
                    </div>
                </div>
            </div>  

            <div id="right-panel" class="hud-panel">  
                <div class="panel-header">
                    <h3 id="right-title">RESPONSE STACK</h3>  
                    <button class="close-btn" onclick="closePanel('right-panel')">✕</button>
                </div>
                <div id="right-content">  
                    <p style="opacity: 0.7;">Greetings, Sir. Speak or type instructions...</p>
                </div>  
            </div>  
        </div>  

        <div class="terminal-area">  
            <div id="log" class="log-box">SYSTEM: Standby mode active. Listening for commands...</div>  
            <div class="controls">  
                <input type="text" id="userInput" placeholder="Ask anything, say 'take a note...', 'help me build...'" onkeydown="if(event.key==='Enter') processInput()">  
                <button onclick="processInput()">SEND</button>  
                <button id="micBtn" onclick="toggleVoiceListening()">MIC: ON</button>  
            </div>  
        </div>  
    </div>  

    <script>  
        let availableVoices = [];
        let familyCalendar = JSON.parse(localStorage.getItem('jarvis_calendar')) || [
            { title: "Family Game Night", date: "2026-08-07" },
            { title: "Mom's Birthday", date: "2026-08-15" }
        ];
        let userNotes = JSON.parse(localStorage.getItem('jarvis_notes')) || [
            { text: "Check suit telemetry for flight test", date: "2026-08-01" }
        ];
        let jarvisMemory = JSON.parse(localStorage.getItem('jarvis_memory')) || {};
        let favoriteWebsites = JSON.parse(localStorage.getItem('jarvis_favorites')) || [
            { name: "YouTube", url: "https://www.youtube.com" },
            { name: "Google", url: "https://www.google.com" }
        ];
        let recognition = null;
        let isListening = false;

        const GREETING_RESPONSES = [
            "Hello Sir, what can I do for you today?",
            "At your service, Sir. What do you need?",
            "Always a pleasure, Sir. How can I help?",
            "Online and fully operational, Sir."
        ];

        window.onload = () => {
            renderCalendar();
            renderNotes();
            renderFavorites();
            initVoiceRecognition();
        };

        setTimeout(() => {  
            const loader = document.getElementById('loader');  
            if (loader) {  
                loader.style.opacity = '0';  
                setTimeout(() => {  
                    loader.style.display = 'none'; 
                    speak("System online. Permanent memory restored. Wake words activated.");  
                }, 800);  
            }  
        }, 1500);

        setInterval(() => {  
            const clock = document.getElementById('clock');  
            if (clock) clock.innerText = new Date().toLocaleTimeString();  
            
            const tempVal = document.getElementById('val-temp');
            const loadVal = document.getElementById('val-load');
            if (tempVal) tempVal.innerText = (40 + Math.floor(Math.random() * 5)) + "°C";
            if (loadVal) loadVal.innerText = (15 + Math.floor(Math.random() * 20)) + "%";
        }, 1000);

        function speak(text) {  
            try {  
                if (!('speechSynthesis' in window)) return;
                window.speechSynthesis.cancel();  

                const utterance = new SpeechSynthesisUtterance(text);  
                utterance.pitch = 0.95;  
                utterance.rate = 1.0;    

                const voices = availableVoices.length ? availableVoices : window.speechSynthesis.getVoices();
                const preferredVoice = voices.find(v => 
                    v.name.includes('Google UK English Male') || 
                    v.name.includes('Natural') ||
                    v.name.includes('Oliver') ||
                    v.name.includes('Daniel') ||
                    v.name.includes('Arthur')
                ) || voices.find(v => v.lang.includes('en-GB')) || voices[0];  

                if (preferredVoice) utterance.voice = preferredVoice;  
                window.speechSynthesis.speak(utterance);
            } catch (e) {}  

            const log = document.getElementById('log');
            if (log) log.innerText = "JARVIS: " + text;  
        }  

        window.speechSynthesis.onvoiceschanged = () => {  
            availableVoices = window.speechSynthesis.getVoices();
        };  

        function stopSpeaking() {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
            }
            const log = document.getElementById('log');
            if (log) log.innerText = "SYSTEM: Audio stopped by user.";
        }

        function closePanel(panelId) {
            document.getElementById(panelId).style.display = 'none';
        }

        function showPanel(panelSide) {
            const panel = document.getElementById(panelSide + '-panel');
            if (panel) panel.style.display = 'block';
        }

        function saveStateToDisk() {
            localStorage.setItem('jarvis_calendar', JSON.stringify(familyCalendar));
            localStorage.setItem('jarvis_notes', JSON.stringify(userNotes));
            localStorage.setItem('jarvis_memory', JSON.stringify(jarvisMemory));
            localStorage.setItem('jarvis_favorites', JSON.stringify(favoriteWebsites));
        }

        function renderCalendar() {
            const list = document.getElementById('calendar-list');
            if (!list) return;
            list.innerHTML = '';
            familyCalendar.forEach((evt) => {
                const item = document.createElement('div');
                item.className = 'calendar-item';
                item.innerHTML = `<div><div class="event-title">${evt.title}</div><div class="event-date">📅 ${evt.date}</div></div>
                <button class="expand-btn" style="padding:2px 5px;" onclick="syncToGoogleCalendar('${encodeURIComponent(evt.title)}', '${evt.date}')">Sync</button>`;
                list.appendChild(item);
            });
            saveStateToDisk();
        }

        function renderNotes() {
            const list = document.getElementById('notes-list');
            if (!list) return;
            list.innerHTML = '';
            if (userNotes.length === 0) {
                list.innerHTML = '<div style="font-size:0.75rem; opacity:0.6;">No saved notes. Say "take a note..."</div>';
                return;
            }
            userNotes.forEach((note, index) => {
                const item = document.createElement('div');
                item.className = 'note-item';
                item.innerHTML = `<div><div class="note-text">• ${note.text}</div><div class="note-date">🕒 ${note.date}</div></div>
                <button class="expand-btn" style="padding:2px 5px;" onclick="deleteNote(${index})">✕</button>`;
                list.appendChild(item);
            });
            saveStateToDisk();
        }

        function deleteNote(index) {
            userNotes.splice(index, 1);
            renderNotes();
            speak("Note deleted, Sir.");
        }

        function addNoteFromUI() {
            const input = document.getElementById('noteInput');
            if (!input || !input.value.trim()) return;
            const text = input.value.trim();
            const dateStr = new Date().toLocaleDateString();
            userNotes.push({ text: text, date: dateStr });
            renderNotes();
            speak(`Jotted down note: ${text}`);
            input.value = '';
        }

        function renderFavorites() {
            const grid = document.getElementById('favorite-websites-grid');
            if (!grid) return;
            grid.innerHTML = '';
            if (favoriteWebsites.length === 0) {
                grid.innerHTML = '<div style="font-size:0.75rem; opacity:0.6;">No favorite websites saved yet.</div>';
                return;
            }
            favoriteWebsites.forEach((site) => {
                const a = document.createElement('a');
                a.href = site.url;
                a.target = '_blank';
                a.className = 'site-link';
                a.innerHTML = `<span>★ ${site.name}</span> ↗`;
                grid.appendChild(a);
            });
            saveStateToDisk();
        }

        function syncToGoogleCalendar(title, dateStr) {
            const cleanDate = dateStr.replace(/-/g, '');
            const gCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${cleanDate}/${cleanDate}`;
            window.open(gCalUrl, '_blank');
        }

        function addCalendarEventFromUI() {
            const titleInput = document.getElementById('eventTitle');
            const dateInput = document.getElementById('eventDate');
            if (!titleInput.value) return;

            const title = titleInput.value;
            const dateStr = dateInput.value || new Date().toISOString().split('T')[0];
            
            familyCalendar.push({ title: title, date: dateStr });
            renderCalendar();

            speak(`Adding ${title} to your Google Calendar, Sir.`);
            syncToGoogleCalendar(encodeURIComponent(title), dateStr);

            titleInput.value = '';
            dateInput.value = '';
        }

        /* CONTINUOUS VOICE & WAKE WORD RECOGNITION ENGINE */
        function initVoiceRecognition() {
            if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
                return;
            }

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = false;
            recognition.lang = 'en-US';

            recognition.onresult = (event) => {
                const lastResultIndex = event.results.length - 1;
                const transcript = event.results[lastResultIndex][0].transcript.trim();
                document.getElementById('userInput').value = transcript;
                processInput();
            };

            recognition.onerror = () => {
                if (isListening) setTimeout(() => recognition.start(), 1000);
            };

            recognition.onend = () => {
                if (isListening) recognition.start();
            };

            toggleVoiceListening(true);
        }

        function toggleVoiceListening(forceStart = false) {
            if (!recognition) return;
            const micBtn = document.getElementById('micBtn');

            if (isListening && !forceStart) {
                isListening = false;
                recognition.stop();
                if (micBtn) micBtn.innerText = "MIC: OFF";
                speak("Voice recognition disabled.");
            } else {
                isListening = true;
                try { recognition.start(); } catch(e) {}
                if (micBtn) micBtn.innerText = "MIC: LISTENING";
            }
        }

        /* CAPABILITIES DISPLAY FUNCTION */
        function listJarvisCapabilities() {
            showPanel('right');
            const rightContent = document.getElementById('right-content');
            rightContent.innerHTML = `
                <div class="response-card enlarged">
